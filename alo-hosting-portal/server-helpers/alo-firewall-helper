#!/usr/bin/env bash
#
# ALO Labs Hosting Portal — Firewall Helper
# Manages UFW firewall rules on the host system.
# Called by Node.js via child_process.execFile with validated arguments.
#
set -euo pipefail

# ── helpers ──────────────────────────────────────────────────────────────────
log_err() { printf '[alo-firewall-helper] ERROR: %s\n' "$*" >&2; }
log_info() { printf '[alo-firewall-helper] INFO: %s\n' "$*" >&2; }
json_out() { printf '%s\n' "$*"; }

die() {
  local step="$1"
  local msg="$2"
  json_out "{\"success\":false,\"step\":\"${step}\",\"error\":\"${msg}\"}"
  exit 1
}

# ── argument validation ─────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  die "arg-validation" "Usage: alo-firewall-helper <action> [args...]"
fi

ACTION="$1"
shift

validate_port() {
  if [[ ! "$1" =~ ^[0-9]{1,5}$ ]]; then
    die "arg-validation" "Invalid port: $1"
  fi
  local port_value=$((10#$1))
  if (( port_value < 1 || port_value > 65535 )); then
    die "arg-validation" "Invalid port: $1"
  fi
}

validate_protocol() {
  if [[ "$1" != "tcp" && "$1" != "udp" ]]; then
    die "arg-validation" "Invalid protocol: $1 (must be tcp or udp)"
  fi
}

validate_ip() {
  # UFW accepts IPv4 addresses and CIDR ranges. Keep the accepted syntax
  # deliberately narrow and validate every octet/prefix before invocation.
  local value="$1" address="$1" prefix="" octet
  if [[ "$value" == */* ]]; then
    address="${value%/*}"
    prefix="${value##*/}"
    if [[ ! "$prefix" =~ ^[0-9]{1,2}$ ]] || (( 10#$prefix > 32 )); then
      die "arg-validation" "Invalid IPv4 CIDR prefix: $value"
    fi
  fi
  if [[ ! "$address" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    die "arg-validation" "Invalid IPv4 address or CIDR: $value"
  fi
  local IFS='.'
  read -ra octets <<< "$address"
  for octet in "${octets[@]}"; do
    if (( 10#$octet > 255 )); then
      die "arg-validation" "Invalid IPv4 address or CIDR: $value"
    fi
  done
}

# ── action: status ───────────────────────────────────────────────────────────
action_status() {
  local ufw_status
  ufw_status=$(ufw status 2>/dev/null || echo "inactive")

  # Parse UFW status into JSON
  local status="inactive"
  if echo "$ufw_status" | grep -qi "Status: active"; then
    status="active"
  fi

  # Get numbered rules
  local rules_json="[]"
  if [[ "$status" == "active" ]]; then
    rules_json=$(ufw status numbered 2>/dev/null | awk '
      /^\[/{next}
      /^Status:/{next}
      /^--/{next}
      NF > 0 {
        gsub(/"/, "\\\"", $0);
        printf "%s\"%s\"", (NR>1 ? "," : ""), $0;
      }
      END { printf "" }
    ' | sed 's/^/["/' | sed 's/$/"]/')
  fi

  json_out "{\"success\":true,\"step\":\"status\",\"status\":\"${status}\",\"rules\":${rules_json}}"
}

# ── action: allow ────────────────────────────────────────────────────────────
action_allow() {
  if [[ $# -lt 1 ]]; then
    die "allow" "Usage: allow <port> [protocol] [from-ip]"
  fi

  local port="$1"
  local protocol="${2:-tcp}"
  local from_ip="${3:-}"

  validate_port "$port"
  validate_protocol "$protocol"

  local cmd="ufw allow ${port}/${protocol}"
  if [[ -n "$from_ip" ]]; then
    validate_ip "$from_ip"
    cmd="ufw allow from ${from_ip} to any port ${port} proto ${protocol}"
  fi

  log_info "Executing: ${cmd}"
  local output
  output=$($cmd 2>&1) || die "allow" "Failed to add allow rule: ${output}"

  # Reload UFW
  ufw reload &>/dev/null || true

  json_out "{\"success\":true,\"step\":\"allow\",\"port\":${port},\"protocol\":\"${protocol}\",\"from\":\"${from_ip:-any}\",\"message\":\"Rule added\"}"
}

# ── action: deny ─────────────────────────────────────────────────────────────
action_deny() {
  if [[ $# -lt 1 ]]; then
    die "deny" "Usage: deny <port> [protocol] [from-ip]"
  fi

  local port="$1"
  local protocol="${2:-tcp}"
  local from_ip="${3:-}"

  validate_port "$port"
  validate_protocol "$protocol"

  local cmd="ufw deny ${port}/${protocol}"
  if [[ -n "$from_ip" ]]; then
    validate_ip "$from_ip"
    cmd="ufw deny from ${from_ip} to any port ${port} proto ${protocol}"
  fi

  log_info "Executing: ${cmd}"
  local output
  output=$($cmd 2>&1) || die "deny" "Failed to add deny rule: ${output}"

  ufw reload &>/dev/null || true

  json_out "{\"success\":true,\"step\":\"deny\",\"port\":${port},\"protocol\":\"${protocol}\",\"from\":\"${from_ip:-any}\",\"message\":\"Rule added\"}"
}

# ── action: remove ───────────────────────────────────────────────────────────
action_remove() {
  if [[ $# -lt 3 || $# -gt 4 ]]; then
    die "remove" "Usage: remove <allow|deny> <port> <protocol> [source-ip-or-cidr]"
  fi

  local rule_action="$1" port="$2" protocol="$3" from_ip="${4:-}"
  if [[ "$rule_action" != "allow" && "$rule_action" != "deny" ]]; then
    die "remove" "Unsupported rule action: $rule_action"
  fi
  validate_port "$port"
  validate_protocol "$protocol"

  local output
  if [[ -n "$from_ip" ]]; then
    validate_ip "$from_ip"
    output=$(yes | ufw delete "$rule_action" from "$from_ip" to any port "$port" proto "$protocol" 2>&1) || \
      die "remove" "Failed to remove firewall rule: ${output}"
  else
    output=$(yes | ufw delete "$rule_action" "${port}/${protocol}" 2>&1) || \
      die "remove" "Failed to remove firewall rule: ${output}"
  fi

  ufw reload &>/dev/null || true
  json_out "{\"success\":true,\"step\":\"remove\",\"port\":${port},\"protocol\":\"${protocol}\",\"message\":\"Rule removed\"}"
}

# ── dispatch ─────────────────────────────────────────────────────────────────
case "$ACTION" in
  status)  action_status "$@" ;;
  remove)  action_remove "$@" ;;
  allow)   action_allow "$@" ;;
  deny)    action_deny "$@" ;;
  *)       die "dispatch" "Unknown action: ${ACTION}" ;;
esac
