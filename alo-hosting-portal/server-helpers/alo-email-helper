#!/usr/bin/env bash
#
# ALO Labs Hosting Portal — Email Helper
# Manages Postfix virtual domains and Dovecot mail accounts.
# Called by Node.js via child_process.execFile with validated arguments.
#
set -euo pipefail

VMAIL_DIR="/var/vmail"
POSTFIX_CONFIG_DIR="/etc/postfix"
DOVECOT_CONFIG_DIR="/etc/dovecot"
APP_USER="alo-panel"

# ── helpers ──────────────────────────────────────────────────────────────────
log_err() { printf '[alo-email-helper] ERROR: %s\n' "$*" >&2; }
log_info() { printf '[alo-email-helper] INFO: %s\n' "$*" >&2; }
json_out() { printf '%s\n' "$*"; }

die() {
  local step="$1"
  local msg="$2"
  json_out "{\"success\":false,\"step\":\"${step}\",\"error\":\"${msg}\"}"
  exit 1
}

validate_domain() {
  if [[ ! "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]$ ]]; then
    die "arg-validation" "Invalid domain format: $1"
  fi
}

validate_email_local() {
  # Local part: alphanumeric, dots, hyphens, underscores
  if [[ ! "$1" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    die "arg-validation" "Invalid email local part: $1"
  fi
}

validate_quota() {
  if ! [[ "$1" =~ ^[0-9]+$ ]] || [[ "$1" -lt 1 ]] || [[ "$1" -gt 10240 ]]; then
    die "arg-validation" "Quota must be between 1 and 10240 MB"
  fi
}

# ── argument validation ─────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  die "arg-validation" "Usage: alo-email-helper <action> [args...]"
fi

ACTION="$1"
shift

# ── action: add-domain ───────────────────────────────────────────────────────
action_add_domain() {
  if [[ $# -lt 1 ]]; then
    die "add-domain" "Usage: add-domain <domain>"
  fi

  local domain="$1"
  validate_domain "$domain"

  local domain_dir="${VMAIL_DIR}/${domain}"

  # Create vmail directory for domain
  mkdir -p "$domain_dir"
  chown -R vmail:vmail "$domain_dir"
  chmod 750 "$domain_dir"
  log_info "Created vmail directory: ${domain_dir}"

  # Add to Postfix virtual domains if not already present
  if ! grep -q "${domain}" "${POSTFIX_CONFIG_DIR}/virtual_domains" 2>/dev/null; then
    echo "${domain}" >> "${POSTFIX_CONFIG_DIR}/virtual_domains"
    postmap "${POSTFIX_CONFIG_DIR}/virtual_domains" 2>/dev/null || true
    log_info "Added domain to Postfix virtual_domains"
  fi

  # Add Postfix virtual mailbox mapping base
  local vmap_file="${POSTFIX_CONFIG_DIR}/virtual_mailboxes_${domain}"
  if [[ ! -f "$vmap_file" ]]; then
    touch "$vmap_file"
    postmap "$vmap_file" 2>/dev/null || true
    log_info "Created virtual mailbox map: ${vmap_file}"
  fi

  # Reload Postfix
  systemctl reload postfix 2>/dev/null || true

  json_out "{\"success\":true,\"step\":\"add-domain\",\"domain\":\"${domain}\",\"message\":\"Email domain configured\"}"
}

# ── action: add-account ─────────────────────────────────────────────────────
action_add_account() {
  if [[ $# -lt 3 ]]; then
    die "add-account" "Usage: add-account <domain> <local-part> <password> [quota-mb]"
  fi

  local domain="$1"
  local local_part="$2"
  local password="$3"
  local quota_mb="${4:-500}"

  validate_domain "$domain"
  validate_email_local "$local_part"
  validate_quota "$quota_mb"

  local full_address="${local_part}@${domain}"
  local mail_dir="${VMAIL_DIR}/${domain}/${local_part}"
  local vmap_file="${POSTFIX_CONFIG_DIR}/virtual_mailboxes_${domain}"

  # Check if account already exists
  if [[ -d "$mail_dir" ]]; then
    die "add-account" "Email account already exists: ${full_address}"
  fi

  # Create maildir structure
  mkdir -p "${mail_dir}/{cur,new,tmp}"
  chown -R vmail:vmail "$mail_dir"
  chmod -R 700 "$mail_dir"

  # Add virtual mailbox mapping
  echo "${full_address} ${domain}/${local_part}/" >> "$vmap_file"
  postmap "$vmap_file" 2>/dev/null || true
  log_info "Added mailbox mapping for ${full_address}"

  # Set password via Dovecot's doveadm
  if command -v doveadm &>/dev/null; then
    doveadm pw -s SHA512-CRYPT -p "$password" > "${mail_dir}/.password_hash" 2>/dev/null || true
  fi

  # Set quota
  if command -v doveadm &>/dev/null; then
    doveadm quota set -u "${full_address}" "storage=${quota_mb}M" 2>/dev/null || true
  fi

  # Reload services
  systemctl reload postfix 2>/dev/null || true
  systemctl reload dovecot 2>/dev/null || true

  log_info "Created email account: ${full_address}"

  json_out "{\"success\":true,\"step\":\"add-account\",\"address\":\"${full_address}\",\"quotaMb\":${quota_mb},\"message\":\"Email account created\"}"
}

# ── action: delete-account ──────────────────────────────────────────────────
action_delete_account() {
  if [[ $# -lt 2 ]]; then
    die "delete-account" "Usage: delete-account <domain> <local-part>"
  fi

  local domain="$1"
  local local_part="$2"

  validate_domain "$domain"
  validate_email_local "$local_part"

  local full_address="${local_part}@${domain}"
  local mail_dir="${VMAIL_DIR}/${domain}/${local_part}"
  local vmap_file="${POSTFIX_CONFIG_DIR}/virtual_mailboxes_${domain}"

  # Remove from virtual mailbox mapping
  if [[ -f "$vmap_file" ]]; then
    sed -i "/^${full_address}/d" "$vmap_file"
    postmap "$vmap_file" 2>/dev/null || true
  fi

  # Remove maildir
  if [[ -d "$mail_dir" ]]; then
    rm -rf "${mail_dir}"
    log_info "Removed maildir: ${mail_dir}"
  fi

  # Remove quota
  if command -v doveadm &>/dev/null; then
    doveadm quota remove -u "${full_address}" 2>/dev/null || true
  fi

  systemctl reload postfix 2>/dev/null || true

  json_out "{\"success\":true,\"step\":\"delete-account\",\"address\":\"${full_address}\",\"message\":\"Email account deleted\"}"
}

# ── action: set-quota ────────────────────────────────────────────────────────
action_set_quota() {
  if [[ $# -lt 3 ]]; then
    die "set-quota" "Usage: set-quota <domain> <local-part> <quota-mb>"
  fi

  local domain="$1"
  local local_part="$2"
  local quota_mb="$3"

  validate_domain "$domain"
  validate_email_local "$local_part"
  validate_quota "$quota_mb"

  local full_address="${local_part}@${domain}"

  if command -v doveadm &>/dev/null; then
    doveadm quota set -u "${full_address}" "storage=${quota_mb}M" 2>/dev/null || \
      die "set-quota" "Failed to set quota for ${full_address}"
  fi

  json_out "{\"success\":true,\"step\":\"set-quota\",\"address\":\"${full_address}\",\"quotaMb\":${quota_mb},\"message\":\"Quota updated\"}"
}

# ── action: get-quota ────────────────────────────────────────────────────────
action_get_quota() {
  if [[ $# -lt 2 ]]; then
    die "get-quota" "Usage: get-quota <domain> <local-part>"
  fi

  local domain="$1"
  local local_part="$2"
  validate_domain "$domain"
  validate_email_local "$local_part"

  local full_address="${local_part}@${domain}"
  local quota_json="{}"

  if command -v doveadm &>/dev/null; then
    local quota_output
    quota_output=$(doveadm quota get -u "${full_address}" 2>/dev/null || echo "")
    if [[ -n "$quota_output" ]]; then
      local current_bytes max_bytes
      current_bytes=$(echo "$quota_output" | awk 'NR==1{print $2}' || echo "0")
      max_bytes=$(echo "$quota_output" | awk 'NR==1{print $3}' || echo "0")
      quota_json="{\"currentBytes\":${current_bytes:-0},\"maxBytes\":${max_bytes:-0}}"
    fi
  fi

  json_out "{\"success\":true,\"step\":\"get-quota\",\"address\":\"${full_address}\",\"quota\":${quota_json}}"
}

# ── action: domain-status ───────────────────────────────────────────────────
action_domain_status() {
  if [[ $# -lt 1 ]]; then
    die "domain-status" "Usage: domain-status <domain>"
  fi

  local domain="$1"
  validate_domain "$domain"

  local domain_dir="${VMAIL_DIR}/${domain}"
  local has_domain="false"
  local account_count=0

  if [[ -d "$domain_dir" ]]; then
    has_domain="true"
    account_count=$(find "${domain_dir}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
  fi

  local postfix_enabled="false"
  if grep -q "${domain}" "${POSTFIX_CONFIG_DIR}/virtual_domains" 2>/dev/null; then
    postfix_enabled="true"
  fi

  json_out "{\"success\":true,\"step\":\"domain-status\",\"domain\":\"${domain}\",\"configured\":${has_domain},\"postfixEnabled\":${postfix_enabled},\"accountCount\":${account_count}}"
}

# ── dispatch ─────────────────────────────────────────────────────────────────
case "$ACTION" in
  add-domain)      action_add_domain "$@" ;;
  add-account)     action_add_account "$@" ;;
  delete-account)  action_delete_account "$@" ;;
  set-quota)       action_set_quota "$@" ;;
  get-quota)       action_get_quota "$@" ;;
  domain-status)   action_domain_status "$@" ;;
  *)               die "dispatch" "Unknown action: ${ACTION}" ;;
esac
