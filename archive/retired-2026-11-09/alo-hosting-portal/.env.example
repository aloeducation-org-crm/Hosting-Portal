# ═══════════════════════════════════════════
#  ALO Hosting Portal — Environment Variables
#  Copy to .env and fill in real values
# ═══════════════════════════════════════════

# ─── App ───
NODE_ENV=production
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql://alamin_app:CHANGE_ME@localhost:5432/alo_hosting

# ─── Redis (optional) ───
REDIS_URL=redis://localhost:6379

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_WEBHOOK_SECRET_2=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ─── AI / LLM ───
AI_GATEWAY_URL=http://localhost:4000/v1
AI_GATEWAY_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Email (SMTP) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ─── Storage ───
STORAGE_PROVIDER=local
STORAGE_PATH=/srv/app/alo-hosting-portal/uploads

# ─── Security ───
RATE_LIMIT_MAX=100
SESSION_MAX_AGE=86400
