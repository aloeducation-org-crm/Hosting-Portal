#!/usr/bin/env bash
#
# ALO Labs Hosting Portal — Log Helper
# Reads application and infrastructure logs for hosted sites.
# Called by Node.js via child_process.execFile with validated arguments.
#
set -euo pipefail

CADDY_LOG_DIR="/var/log/caddy/alo-sites"
SITE_BASE="/srv/alo-sites"
APP_USER="aloedu"

# ── helpers ──────────────────────────────────────────────────────────────────
log_err() { printf '[alo-log-helper] ERROR: %s\n' "$*" >&2; }
log_info() { printf '[alo-log-helper] INFO: %s\n' "$*" >&2; }
json_out() { printf '%s\n' "$*"; }

die() {
  local step="$1"
  local msg="$2"
  json_out "{\"success\":false,\"step\":\"${step}\",\"error\":\"${msg}\"}"
  exit 1
}

validate_domain() {
  if [[ ! "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]$ ]]; then
    die "arg-validation" "Invalid domain format: $1"
  fi
}

# Safely encode log content to base64 for JSON transport
encode_logs() {
  local file_path="$1"
  local max_lines="$2"

  if [[ ! -f "$file_path" ]]; then
    printf '[]'
    return
  fi

  local log_content
  if [[ "$max_lines" -gt 0 ]]; then
    log_content=$(tail -n "$max_lines" "$file_path" 2>/dev/null || echo "")
  else
    log_content=$(cat "$file_path" 2>/dev/null || echo "")
  fi

  if [[ -z "$log_content" ]]; then
    printf '[]'
    return
  fi

  local encoded
  encoded=$(printf '%s' "$log_content" | base64 -w 0)
  printf '%s' "[{\"encoding\":\"base64\",\"lines\":${max_lines},\"content\":\"${encoded}\"}]"
}

# ── argument validation ─────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  die "arg-validation" "Usage: alo-log-helper <action> <domain> [args...]"
fi

ACTION="$1"
shift

if [[ $# -lt 1 ]]; then
  die "arg-validation" "Usage: alo-log-helper <action> <domain> [args...]"
fi

DOMAIN="$1"
shift
validate_domain "$DOMAIN"

SERVICE_NAME="alo-site-${DOMAIN}"
DEFAULT_LINES=100

# ── action: application ─────────────────────────────────────────────────────
action_application() {
  local lines="${1:-${DEFAULT_LINES}}"

  if ! [[ "$lines" =~ ^[0-9]+$ ]] || [[ "$lines" -eq 0 ]]; then
    lines="$DEFAULT_LINES"
  fi

  local log_content
  log_content=$(journalctl -u "${SERVICE_NAME}.service" -n "$lines" --no-pager --output=cat 2>/dev/null || echo "")

  if [[ -z "$log_content" ]]; then
    json_out "{\"success\":true,\"step\":\"application\",\"domain\":\"${DOMAIN}\",\"lines\":[],\"count\":0}"
    return
  fi

  local encoded
  encoded=$(printf '%s' "$log_content" | base64 -w 0)
  local line_count
  line_count=$(printf '%s' "$log_content" | wc -l)

  json_out "{\"success\":true,\"step\":\"application\",\"domain\":\"${DOMAIN}\",\"lines\":[{\"encoding\":\"base64\",\"count\":${line_count},\"content\":\"${encoded}\"}]}"
}

# ── action: access ───────────────────────────────────────────────────────────
action_access() {
  local lines="${1:-${DEFAULT_LINES}}"

  if ! [[ "$lines" =~ ^[0-9]+$ ]] || [[ "$lines" -eq 0 ]]; then
    lines="$DEFAULT_LINES"
  fi

  local access_log="${CADDY_LOG_DIR}/${DOMAIN}-access.log"

  if [[ ! -f "$access_log" ]]; then
    json_out "{\"success\":true,\"step\":\"access\",\"domain\":\"${DOMAIN}\",\"lines\":[],\"count\":0,\"message\":\"No access log found\"}"
    return
  fi

  local encoded
  encoded=$(tail -n "$lines" "$access_log" | base64 -w 0)
  local line_count
  line_count=$(tail -n "$lines" "$access_log" | wc -l)

  json_out "{\"success\":true,\"step\":\"access\",\"domain\":\"${DOMAIN}\",\"lines\":[{\"encoding\":\"base64\",\"count\":${line_count},\"content\":\"${encoded}\"}]}"
}

# ── action: error ───────────────────────────────────────────────────────────
action_error() {
  local lines="${1:-${DEFAULT_LINES}}"

  if ! [[ "$lines" =~ ^[0-9]+$ ]] || [[ "$lines" -eq 0 ]]; then
    lines="$DEFAULT_LINES"
  fi

  local error_log="${CADDY_LOG_DIR}/${DOMAIN}-error.log"

  if [[ ! -f "$error_log" ]]; then
    json_out "{\"success\":true,\"step\":\"error\",\"domain\":\"${DOMAIN}\",\"lines\":[],\"count\":0,\"message\":\"No error log found\"}"
    return
  fi

  local encoded
  encoded=$(tail -n "$lines" "$error_log" | base64 -w 0)
  local line_count
  line_count=$(tail -n "$lines" "$error_log" | wc -l)

  json_out "{\"success\":true,\"step\":\"error\",\"domain\":\"${DOMAIN}\",\"lines\":[{\"encoding\":\"base64\",\"count\":${line_count},\"content\":\"${encoded}\"}]}"
}

# ── action: caddy ────────────────────────────────────────────────────────────
action_caddy() {
  local lines="${1:-${DEFAULT_LINES}}"

  if ! [[ "$lines" =~ ^[0-9]+$ ]] || [[ "$lines" -eq 0 ]]; then
    lines="$DEFAULT_LINES"
  fi

  local access_log="${CADDY_LOG_DIR}/${DOMAIN}-access.log"
  local error_log="${CADDY_LOG_DIR}/${DOMAIN}-error.log"

  local access_encoded="[]"
  local access_count=0
  local error_encoded="[]"
  local error_count=0

  if [[ -f "$access_log" ]]; then
    access_encoded=$(tail -n "$lines" "$access_log" | base64 -w 0)
    access_count=$(tail -n "$lines" "$access_log" | wc -l)
  fi

  if [[ -f "$error_log" ]]; then
    error_encoded=$(tail -n "$lines" "$error_log" | base64 -w 0)
    error_count=$(tail -n "$lines" "$error_log" | wc -l)
  fi

  json_out "{\"success\":true,\"step\":\"caddy\",\"domain\":\"${DOMAIN}\",\"access\":{\"encoding\":\"base64\",\"count\":${access_count},\"content\":\"${access_encoded}\"},\"error\":{\"encoding\":\"base64\",\"count\":${error_count},\"content\":\"${error_encoded}\"}}"
}

# ── action: deployment ───────────────────────────────────────────────────────
action_deployment() {
  if [[ $# -lt 1 ]]; then
    die "deployment" "Usage: deployment <domain> <deployment-id>"
  fi

  local deployment_id="$1"

  # Validate deployment ID: alphanumeric, hyphens only
  if [[ ! "$deployment_id" =~ ^[a-zA-Z0-9-]+$ ]]; then
    die "deployment" "Invalid deployment ID format"
  fi

  local site_dir="${SITE_BASE}/${DOMAIN}"
  local deploy_log="${site_dir}/releases/${deployment_id}/deploy.log"

  # Also check log directory
  if [[ ! -f "$deploy_log" ]]; then
    deploy_log="${site_dir}/logs/deploy-${deployment_id}.log"
  fi

  if [[ ! -f "$deploy_log" ]]; then
    json_out "{\"success\":true,\"step\":\"deployment\",\"domain\":\"${DOMAIN}\",\"deploymentId\":\"${deployment_id}\",\"lines\":[],\"count\":0,\"message\":\"Deployment log not found\"}"
    return
  fi

  local encoded
  encoded=$(cat "$deploy_log" | base64 -w 0)
  local line_count
  line_count=$(wc -l < "$deploy_log")

  json_out "{\"success\":true,\"step\":\"deployment\",\"domain\":\"${DOMAIN}\",\"deploymentId\":\"${deployment_id}\",\"lines\":[{\"encoding\":\"base64\",\"count\":${line_count},\"content\":\"${encoded}\"}]}"
}

# ── dispatch ─────────────────────────────────────────────────────────────────
case "$ACTION" in
  application) action_application "$@" ;;
  access)      action_access "$@" ;;
  error)       action_error "$@" ;;
  caddy)       action_caddy "$@" ;;
  deployment)  action_deployment "$@" ;;
  *)           die "dispatch" "Unknown action: ${ACTION}" ;;
esac
