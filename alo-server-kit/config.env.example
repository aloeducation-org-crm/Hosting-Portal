# =============================================================================
# alo-server-kit  ·  Configuration template
# Copy to "config.env" (chmod 0600) and edit before running ./setup.sh
# =============================================================================
KIT_HOSTNAME="alo-server-lap"
KIT_PRIMARY_USER="alamin"
KIT_TIMEZONE="Asia/Dhaka"
KIT_LAN_CIDR="192.168.0.0/24"
KIT_TAILSCALE_IF="tailscale0"

KIT_SSH_PORT="2244"

KIT_DOMAIN="alo.example.com"
KIT_ADMIN_EMAIL="alamin@example.com"
KIT_NGINX_WEBROOT="/var/www/html"

KIT_NODE_LTS="lts/iron"
KIT_PM2_INSTANCES="2"
KIT_APP_DIR="/srv/alo-app"

KIT_PG_VERSION="14"
KIT_PG_APP_USER="alo_app"
KIT_PG_APP_DB="alo_db"

KIT_MYSQL_APP_USER="alo_app"
KIT_MYSQL_APP_DB="alo_db"

KIT_OLLAMA_PORT="11434"
KIT_OLLAMA_MODELS="qwen2.5:7b llama3.1:8b codellama:7b"
KIT_OLLAMA_MEM_MAX="8G"

KIT_LITELLM_PORT="4000"
# Generate with: printf 'sk-%s\n' "$(openssl rand -hex 24)"
KIT_LITELLM_MASTER_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24"
KIT_LITELLM_SALT_KEY="CHANGE_ME_GENERATE_SALT_WITH_OPENSSL_RAND_HEX_24"
# Scoped client/developer API key (distinct from master key)
KIT_AI_CLIENT_KEY=""

KIT_GEMINI_API_KEY=""
KIT_GROQ_API_KEY=""
KIT_CLOUDFLARE_AI_ACCOUNT_ID=""
KIT_CLOUDFLARE_AI_API_TOKEN=""

# Open WebUI uses port 3005 (avoids colliding with Next.js / PM2 on 3000-3001).
# License notice: Open WebUI License restricts branding removal >50 users; use LibreChat (MIT) for white-label/multi-tenant.
KIT_INSTALL_OPENWEBUI="yes"
KIT_OPENWEBUI_VERSION="0.6.5"
KIT_OPENWEBUI_PORT="3005"
KIT_EXPOSE_AI_PUBLIC="no"

# Optional basic-auth passwords for non-interactive setup (auto-generated into /root/.alo-secrets/http-basic-auth.txt if blank)
KIT_HTTP_BASIC_PASS=""

KIT_TELEGRAM_BOT_TOKEN=""
KIT_TELEGRAM_CHAT_ID=""

KIT_NETDATA_PORT="19999"

KIT_SAMBA_USER="alamin"
KIT_SAMBA_PASS=""
KIT_SYNCTHING_PORT="8384"
