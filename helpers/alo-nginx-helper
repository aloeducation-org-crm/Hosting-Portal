#!/usr/bin/env bash
#
# ALO Labs Hosting Portal — Nginx Helper
# Manages dynamic Nginx server blocks for tenant sites: writes a vhost into
# sites-available, enables it in sites-enabled, validates the config and
# reloads Nginx. Called by the panel via sudo with validated arguments.
#
# This is the Nginx counterpart to alo-domain-helper (which manages Caddy /
# alo-edge). It is what makes a "publish from the dashboard" flow actually
# produce a live reverse-proxy entry on an Nginx host.
#
# Commands:
#   site-add    <domain> <port> [sslMode]   write + enable + reload a vhost
#   site-reload <domain>                    validate + reload a vhost
#   site-remove <domain>                    disable + remove a vhost
#   site-exists <domain>                    report whether a vhost is enabled
#
# sslMode: cloudflare-http80 (default, :80 origin + ACME webroot) |
#          letsencrypt-strict (80->443 redirect + TLS block)
#
set -euo pipefail

# Directory layout. Env-overridable so tests can sandbox the helper against a
# temp tree without touching the host's /etc/nginx.
NGINX_SITES_AVAILABLE="${NGINX_SITES_AVAILABLE:-/etc/nginx/sites-available}"
NGINX_SITES_ENABLED="${NGINX_SITES_ENABLED:-/etc/nginx/sites-enabled}"
CERTBOT_WEBROOT="${CERTBOT_WEBROOT:-/var/www/certbot}"
APP_USER="${APP_USER:-alo-panel}"
APP_GROUP="${APP_GROUP:-alo-panel}"

log_err() { printf '[alo-nginx-helper] ERROR: %s\n' "$*" >&2; }
log_info() { printf '[alo-nginx-helper] INFO: %s\n' "$*" >&2; }
json_out() { printf '%s\n' "$*"; }

die() {
  local step="$1"
  local msg="$2"
  json_out "{\"success\":false,\"step\":\"${step}\",\"error\":\"${msg}\"}"
  exit 1
}

json_escape() {
  local s="$1"
  local bs=$'\\' q=$'"' nl=$'\n' cr=$'\r' tab=$'\t'
  s="${s//$bs/$bs$bs}"
  s="${s//$q/\\$q}"
  s="${s//$nl/\\n}"
  s="${s//$cr/\\r}"
  s="${s//$tab/\\t}"
  printf '%s' "$s"
}

validate_domain() {
  if [[ ! "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]{0,251}[a-zA-Z0-9])?$ ]]; then
    die "arg-validation" "Invalid domain name: $1"
  fi
}

validate_port() {
  if [[ ! "$1" =~ ^[0-9]+$ ]] || (( $1 < 1024 || $1 > 65535 )); then
    die "arg-validation" "Invalid port: $1 (must be an integer 1024-65535)"
  fi
  # SEC-11: never proxy a tenant app onto a platform port.
  for reserved in 3000 3051 8080; do
    if [[ "$1" == "$reserved" ]]; then
      die "arg-validation" "Port $1 is reserved for the hosting platform"
    fi
  done
}

validate_ssl_mode() {
  if [[ -n "$1" && "$1" != "cloudflare-http80" && "$1" != "letsencrypt-strict" ]]; then
    die "arg-validation" "sslMode must be cloudflare-http80 or letsencrypt-strict"
  fi
}

vhost_path() {
  printf '%s/%s.conf' "$NGINX_SITES_AVAILABLE" "$1"
}

enabled_path() {
  printf '%s/%s' "$NGINX_SITES_ENABLED" "$1"
}

# Generate the Nginx server block for a domain/port. Mirrors the panel's
# generateNginxSiteConfig() so the two never drift.
generate_vhost() {
  local domain="$1" port="$2" ssl_mode="$3"
  if [[ "$ssl_mode" == "letsencrypt-strict" ]]; then
    cat <<VHOST
# Managed by ALO Hosting Panel — alo-nginx-helper
# SSL Mode: Cloudflare Full (Strict) + Let's Encrypt
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location /.well-known/acme-challenge/ {
        root ${CERTBOT_WEBROOT};
        default_type "text/plain";
    }

    location / {
        return 301 https://$host\$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${domain};

    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;
    server_tokens off;
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
    }
}
VHOST
  else
    cat <<VHOST
# Managed by ALO Hosting Panel — alo-nginx-helper
# File: ${NGINX_SITES_AVAILABLE}/${domain}
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    server_tokens off;
    client_max_body_size 50M;

    location /.well-known/acme-challenge/ {
        root ${CERTBOT_WEBROOT};
        default_type "text/plain";
    }

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_cache_bypass \$http_upgrade;
    }
}
VHOST
  fi
}

reload_nginx() {
  # Prefer the classic signal (works regardless of init system), then fall
  # back to systemd. If Nginx is not installed on this host there is nothing
  # to reload: the vhost is still written and enabled, so report success with
  # a note rather than failing the whole site-add.
  if command -v nginx >/dev/null 2>&1; then
    nginx -t 2>&1 || return 1
    nginx -s reload 2>&1 || return 1
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files nginx.service >/dev/null 2>&1; then
    systemctl reload nginx 2>&1 || return 1
    return 0
  fi
  log_info "nginx is not installed on this host; skipping reload"
  return 0
}

# ── action: site-add ────────────────────────────────────────────────────────
action_site_add() {
  if [[ $# -lt 2 ]]; then
    die "site-add" "Usage: site-add <domain> <port> [sslMode]"
  fi
  local domain="$1" port="$2" ssl_mode="${3:-cloudflare-http80}"
  validate_domain "$domain"
  validate_port "$port"
  validate_ssl_mode "$ssl_mode"

  mkdir -p "$NGINX_SITES_AVAILABLE" "$NGINX_SITES_ENABLED"

  local conf="$(vhost_path "$domain")"
  local enabled="$(enabled_path "$domain")"

  # Idempotent: a matching vhost is a success (safe to re-run on workflow
  # retry); a conflicting one is refused rather than silently overwritten.
  if [[ -f "$conf" ]]; then
    local existing_port
    existing_port=$(grep -oE 'proxy_pass http://127.0.0.1:[0-9]+' "$conf" | head -1 | grep -oE '[0-9]+$' || true)
    if [[ "$existing_port" == "$port" ]]; then
      log_info "Vhost already exists for ${domain} on port ${port}; enabling + reloading"
    else
      die "site-add" "Vhost already exists for ${domain} with upstream port ${existing_port:-unknown} (requested ${port})"
    fi
  else
    generate_vhost "$domain" "$port" "$ssl_mode" > "$conf"
    # Prefer the platform group; fall back to root:root on hosts where the
    # alo-panel group has not been created. The vhost is world-readable.
    chown root:"$APP_GROUP" "$conf" 2>/dev/null || chown root:root "$conf" 2>/dev/null || true
    chmod 0644 "$conf"
    log_info "Wrote Nginx vhost: $conf"
  fi

  # Enable: (re)create the symlink. Use -f to replace atomically.
  ln -sf "$conf" "$enabled"
  log_info "Enabled vhost: $enabled"

  reload_nginx || die "site-add" "Nginx config validation or reload failed"

  json_out "{\"success\":true,\"step\":\"site-add\",\"domain\":\"${domain}\",\"port\":${port},\"sslMode\":\"${ssl_mode}\",\"vhost\":\"${conf}\",\"enabled\":\"${enabled}\",\"reloaded\":true}"
}

# ── action: site-reload ──────────────────────────────────────────────────────
action_site_reload() {
  if [[ $# -lt 1 ]]; then
    die "site-reload" "Usage: site-reload <domain>"
  fi
  local domain="$1"
  validate_domain "$domain"

  local enabled="$(enabled_path "$domain")"
  if [[ ! -e "$enabled" ]]; then
    die "site-reload" "No enabled vhost for ${domain}"
  fi
  reload_nginx || die "site-reload" "Nginx config validation or reload failed"
  json_out "{\"success\":true,\"step\":\"site-reload\",\"domain\":\"${domain}\",\"reloaded\":true}"
}

# ── action: site-remove ──────────────────────────────────────────────────────
action_site_remove() {
  if [[ $# -lt 1 ]]; then
    die "site-remove" "Usage: site-remove <domain>"
  fi
  local domain="$1"
  validate_domain "$domain"

  local enabled="$(enabled_path "$domain")"
  local conf="$(vhost_path "$domain")"
  if [[ ! -e "$enabled" && ! -f "$conf" ]]; then
    die "site-remove" "No managed vhost for ${domain}"
  fi
  rm -f "$enabled"
  rm -f "$conf"
  log_info "Removed vhost for ${domain}"
  # Reload only if any vhost remains enabled; a fully empty tree is fine.
  if compgen -G "${NGINX_SITES_ENABLED}/*" > /dev/null; then
    reload_nginx || die "site-remove" "Nginx reload failed after removal"
  fi
  json_out "{\"success\":true,\"step\":\"site-remove\",\"domain\":\"${domain}\",\"removed\":true}"
}

# ── action: site-exists ─────────────────────────────────────────────────────
action_site_exists() {
  if [[ $# -lt 1 ]]; then
    die "site-exists" "Usage: site-exists <domain>"
  fi
  local domain="$1"
  validate_domain "$domain"
  local enabled="$(enabled_path "$domain")"
  local conf="$(vhost_path "$domain")"
  json_out "{\"success\":true,\"step\":\"site-exists\",\"domain\":\"${domain}\",\"exists\":$([ -e "$enabled" ] && echo true || echo false),\"hasConfig\":$([ -f "$conf" ] && echo true || echo false)}"
}

# ── dispatch ─────────────────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  die "dispatch" "Usage: alo-nginx-helper <site-add|site-reload|site-remove|site-exists> [args...]"
fi

ACTION="$1"
shift

case "$ACTION" in
  site-add)      action_site_add "$@" ;;
  site-reload)   action_site_reload "$@" ;;
  site-remove)   action_site_remove "$@" ;;
  site-exists)   action_site_exists "$@" ;;
  *)             die "dispatch" "Unknown action: ${ACTION}" ;;
esac
