[Unit]
Description=ALO Labs Application
After=network.target

[Service]
Type=simple
User=aloedu
WorkingDirectory=/opt/app

# ── Defaults ────────────────────────────────────────────────────────────────
# These are only fallbacks. PORT / HOSTNAME / NODE_ENV live in /opt/app/.env,
# which is loaded below and therefore wins (systemd applies Environment= and
# EnvironmentFile= in the order they appear).
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3101

# ── Single source of truth ──────────────────────────────────────────────────
# Leading '-' = do not fail if the file is missing. To move the panel to a
# different port, edit PORT in /opt/app/.env only — then `systemctl restart`
# and update the Caddy upstream to match.
EnvironmentFile=-/opt/app/.env

ExecStart=/usr/bin/node /opt/app/.next/standalone/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
