{
  "name": "alo-hosting-panel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "npx prisma db push --skip-generate",
    "db:generate": "PRISMA_SCHEMA_ENGINE_BINARY=/bin/true PRISMA_QUERY_ENGINE_LIBRARY=/bin/true PRISMA_QUERY_ENGINE_BINARY=/bin/true prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "PRISMA_SCHEMA_ENGINE_BINARY=/bin/true PRISMA_QUERY_ENGINE_LIBRARY=/bin/true PRISMA_QUERY_ENGINE_BINARY=/bin/true prisma generate"
  },
  "dependencies": {
