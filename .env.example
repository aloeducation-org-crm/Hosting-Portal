# ============================================================
# ALO Labs Hosting Portal — single canonical environment template
# Copy to .env (development) or /etc/alo-hosting/panel.env (production).
# NEVER commit the filled-in file. Generate secrets with: openssl rand -hex 32
# Only NEXT_PUBLIC_* values are exposed to the browser; everything else is
# server-side. Keys appear exactly once — duplicate keys silently override each
# other and were the cause of earlier provider configuration drift.
# See docs/UNIFIED_PROJECT_ENVIRONMENT_VARIABLES.md for the full contract.
# ============================================================

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_APP_URL=https://hosting.alolabs.net
APP_URL=https://hosting.alolabs.net
BASE_URL=https://hosting.alolabs.net
BUILD_ID=""
ALLOW_PREVIEW_EMBED=0

# ── Database (SQLite via libSQL; use an ABSOLUTE file: URL in production) ───
DATABASE_URL="file:/var/lib/alo-hosting/production.db"
E2E_DB=""
REDIS_URL=""

# ── Authentication & secrets (REQUIRED in production; startup fails closed) ─
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
JWT_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
NEXTAUTH_URL="https://hosting.alolabs.net"
APP_ENCRYPTION_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32"
INTERNAL_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
CSRF_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
CRON_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
# Optional: service manager used by /api/automation/tool (systemd | pm2)
AUTOMATION_SERVICE_MANAGER="systemd"
AUTOMATION_SERVICE_NAME="alo-hosting-panel"
SECRET_KEY=""
ADMIN_EMAIL="admin@alolabs.net"
ADMIN_CREDENTIAL_FILE=""
ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_RESELLER_PASSWORD=""
SEED_CLIENT_PASSWORD=""
PANEL_EMAIL="admin@alolabs.net"
PANEL_PASSWORD=""

# ── Browser isolation / CORS ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="https://hosting.alolabs.net"
CROSS_ORIGIN_OPENER_POLICY="same-origin"
CROSS_ORIGIN_RESOURCE_POLICY="same-site"

# ── Privileged host helpers & site storage ─────────────────────────────────
ALO_HELPER_DIR="/usr/local/sbin"
ALO_SITES_DIR="/var/www"
ALO_NGINX_DIR="/etc/nginx/sites-available"
ALO_NGINX_ENABLED_DIR="/etc/nginx/sites-enabled"
ALO_CERTBOT_EMAIL="admin@alolabs.net"
ALO_BACKUP_DIR="/var/backups/alo"
# Optional: absolute path for the best-effort file audit trail. Defaults to
# $ALO_BACKUP_DIR/alo-automation-audit.log, or the OS temp directory.
AUDIT_FALLBACK_FILE=""
ALO_PROJECT_DIR="/opt/alo-hosting-portal"
ALO_ENV_PATH="/etc/alo-hosting/panel.env"
ALO_AGENT_STATE="/var/lib/alo-hosting/agent"
ALO_PANEL_URL="http://127.0.0.1:3051"
ALO_HEARTBEAT_MS=30000
ALO_POLL_MS=5000
ALO_WATCH_SERVICES=""
ALO_ENROLL_TOKEN=""
ALO_CLOUD_API_KEY=""
PROVISION_SITE_HELPER="/usr/local/sbin/provision-site.sh"
PROVISION_LOCAL_SERVER_ID="replace-with-local-server-record-uuid"
SSL_STATUS_HOOK_TOKEN="REPLACE_WITH_OPENSSL_RAND_HEX_32"
SSL_STATUS_API_URL="http://127.0.0.1:3051/api/internal/sites/ssl-status"
MAX_UPLOAD_SIZE_MB=500
STORAGE_BUCKET_BASE=""
STORAGE_ROOT=""
CLOUD_DATA_DIR=""
TEMP_DIR=""

# ── GitHub integration & Git-connected auto-deploy ─────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_REPOSITORY=""
GITHUB_API_URL="https://api.github.com"
GITHUB_OAUTH_URL="https://github.com/login/oauth"
GITHUB_CLONE_BASE_URL="https://github.com"
REPO_FULL_NAME=""
EXPECT_SHA=""
DEPLOY_WEBHOOK_SECRET=""
DEPLOY_RELEASE_BASE="/var/lib/alo-hosting/releases"
DEPLOY_ENV_FILE_BASE="/etc/alo-hosting"
DEPLOY_BIND_HOST="127.0.0.1"
DEPLOY_STATIC_PORT_BASE=4100
DEPLOY_DOMAIN_SUFFIX=""
DEPLOY_PUBLIC_URL_TEMPLATE=""
DEPLOY_COMMAND_TIMEOUT_MS=900000
DEPLOY_WORKER_INTERVAL_MS=5000
DEPLOY_INLINE_WORKER=false
DEPLOY_ALLOW_LOCAL_SOURCE=0
# Local release execution is allowed only when no node profile/default agent is
# selected. Set false to require an enrolled node for application deployment.
DEPLOY_LOCAL_EXECUTION=true
DEPLOY_PUBLIC_IP=""
AUTOMATION_DEFAULT_AGENT_ID=""
DEPLOY_DISABLE_BOOT_RESTORE=0
LOCAL_SOURCE=""
SOURCE_PORT=3051
ALLOW_INSECURE_WEBHOOK_HTTP=0
ALLOW_RELEASE_ROLLBACK=0
RELEASE_ROLLBACK_OPERATOR=""
RELEASE_ROLLBACK_REASON=""
LATEST_MAIN_TIMEOUT_MS=15000
TEST_HEAD=""
TEST_LOOKUP_EXIT=""

# ── SSO / OAuth / MFA ──────────────────────────────────────────────────────
SSO_ENABLED=0
SSO_PROVIDER=""
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_METADATA_URL=""
GOOGLE_CLIENT_ID=""

# ── SMTP / notifications ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@alolabs.net"

# ── DNS / SSL / network providers ─────────────────────────────────────────
DNS_PROVIDER_MODE=""
RDAP_BASE_URL="https://rdap.org/domain"
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# ── CRM / internal service integration ────────────────────────────────────
CRM_INTEGRATION_SIGNING_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32"

# ── Orchestrator / workers ─────────────────────────────────────────────────
ORCHESTRATOR_INTERVAL_MS=5000
ORCHESTRATOR_WORKER_ID=""
ORCHESTRATOR_MAX_JOBS=5
ORCHESTRATOR_HEARTBEAT_FILE=/tmp/alo-automation-worker.json
NEXT_WORKER_ID=""
NEXT_PHASE=""
NEXT_RUNTIME=""

# ── AI providers (all optional, server-side only, never NEXT_PUBLIC_*) ─────
# Ordered failover chain. Configuration alone is never reported as health:
# verify live with GET /api/ai/status?probe=1 (requires authentication).
AI_PROVIDER_ORDER=""
AI_PROVIDER=""
AI_FREE_ONLY="false"
AI_ALLOW_ANONYMOUS="true"
AI_TIMEOUT_MS=60000
AI_RETRIES_PER_PROVIDER=1
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""
PROVIDER_OPENAI_API_KEY=""
AI_MODEL_OPENAI=""

LLM7_API_KEY=""
LLM7_BASE_URL="https://api.llm7.io/v1"
AI_MODEL_LLM7=""

GROQ_API_KEY=""
AI_MODEL_GROQ=""

UNOROUTER_API_KEY=""
UNOROUTER_BASE_URL="https://api.unorouter.com/v1"
AI_MODEL_UNOROUTER=""
OKROUTER_API_KEY=""
OKROUTER_BASE_URL="https://api.okrouter.com/v1"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL_OPENROUTER=""

QWEN_API_KEY=""
QWEN_BASE_URL=""
AI_MODEL_QWEN=""

GLM_API_KEY=""
ZHIPU_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
AI_MODEL_GLM="glm-5"
GLM_REASONING_EFFORT=""

AI_GATEWAY_URL="http://127.0.0.1:4000/v1"
AI_GATEWAY_KEY=""
AI_MODEL_GATEWAY=""

OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
AI_MODEL_OLLAMA=""

LOCALAI_BASE_URL=""
LOCALAI_API_KEY=""
AI_MODEL_LOCALAI=""

# ── Payments (optional Stripe) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET_2=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Rate limiting / logging ────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL="info"

# NOTE: HOME, PATH, npm_lifecycle_event and npm_package_version are provided by
# the runtime/package manager and are intentionally not configurable here.
