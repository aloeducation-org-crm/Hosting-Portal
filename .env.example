# ============================================================
# ALO Labs Hosting Portal - Environment Configuration
# Copy to .env and replace EVERY placeholder before starting in production.
# Generate secrets with: openssl rand -hex 32
# ============================================================

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://hosting.alolabs.net
PORT=3000

# Database (SQLite local default; PostgreSQL recommended for multi-node production)
DATABASE_URL="file:/var/lib/alo-hosting/production.db"

# Authentication (REQUIRED in production — middleware fails closed with HTTP 503 if placeholder/unset)
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
JWT_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
NEXTAUTH_URL="https://hosting.alolabs.net"

# Encryption key for stored secrets (2FA TOTP, API keys, webhooks — 32-byte hex = 64 chars)
APP_ENCRYPTION_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32"

# Internal service-to-service secret (checked in constant time)
INTERNAL_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"

# Privileged helper path
ALO_HELPER_DIR="/usr/local/sbin"
ALO_SITES_DIR="/var/www"
ALO_NGINX_DIR="/etc/nginx/sites-available"
ALO_NGINX_ENABLED_DIR="/etc/nginx/sites-enabled"
ALO_CERTBOT_EMAIL="admin@alolabs.net"
ALO_BACKUP_DIR="/var/backups/alo"

# File manager & upload limits
MAX_UPLOAD_SIZE_MB=500

# GitHub Integration (optional - enables Git deployments)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# SMTP Email (optional - enables email notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@alolabs.net"

# ------------------------------------------------------------
# AI Inference Providers (all optional — server-side only, never NEXT_PUBLIC_*)
# See AI-PROVIDER-INTEGRATION.md and docs/SELF-HOSTED-AI-AGENTS.md
# ------------------------------------------------------------

# Legacy explicit OpenAI-compatible gateway (tried first when set)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""

# Failover chain & safety bounds
# Default chain: unorouter,llm7,groq,gateway,ollama,localai
# Opt-in providers available for AI_PROVIDER_ORDER: openrouter,qwen,glm,openai
AI_PROVIDER_ORDER=""
AI_PROVIDER=""
AI_FREE_ONLY="false"
AI_ALLOW_ANONYMOUS="true"
AI_TIMEOUT_MS=60000
AI_RETRIES_PER_PROVIDER=1
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Free & cloud OpenAI-compatible providers
LLM7_API_KEY=""
LLM7_BASE_URL="https://api.llm7.io/v1"
AI_MODEL_LLM7=""

GROQ_API_KEY=""
AI_MODEL_GROQ=""

UNOROUTER_API_KEY=""
UNOROUTER_BASE_URL=""
AI_MODEL_UNOROUTER=""

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL_OPENROUTER=""

PROVIDER_OPENAI_API_KEY=""
AI_MODEL_OPENAI=""

QWEN_API_KEY=""
QWEN_BASE_URL=""
AI_MODEL_QWEN=""

GLM_API_KEY=""
GLM_BASE_URL=""
AI_MODEL_GLM=""

# Self-hosted local OpenAI-compatible endpoints (opt-in; bind to 127.0.0.1 only)
AI_GATEWAY_URL=""
AI_GATEWAY_KEY=""
AI_MODEL_GATEWAY=""

OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
AI_MODEL_OLLAMA=""

LOCALAI_BASE_URL=""
LOCALAI_API_KEY=""
AI_MODEL_LOCALAI=""

# Payment Integration (optional - Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL="info"

# GLM-5 series (https://github.com/zai-org/GLM-5 — Apache-2.0: glm-5, glm-5.3, glm-5.3-flash)
# Supports Z.ai international (https://api.z.ai/api/paas/v4), Zhipu CN (https://open.bigmodel.cn/api/paas/v4),
# or keyless local vLLM/SGLang via GLM_BASE_URL=http://127.0.0.1:8000/v1
GLM_API_KEY=""
ZHIPU_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
AI_MODEL_GLM="glm-5"

# Additional OpenAI-compatible gateways & local inference engines
LLM7_API_KEY=""
UNOROUTER_API_KEY=""
UNOROUTER_BASE_URL="https://api.unorouter.com/v1"
OKROUTER_API_KEY=""
OKROUTER_BASE_URL="https://api.okrouter.com/v1"
OPENROUTER_API_KEY=""
QWEN_API_KEY=""
GROQ_API_KEY=""
AI_GATEWAY_URL="http://127.0.0.1:4000/v1"
AI_GATEWAY_KEY=""
OLLAMA_BASE_URL=""
LOCALAI_BASE_URL=""
LOCALAI_API_KEY=""
