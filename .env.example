# ============================================================
# ALO Labs Hosting Portal — single canonical environment template
# Copy to .env (development) or /etc/alo-hosting/panel.env (production).
# NEVER commit the filled-in file. Generate secrets with: openssl rand -hex 32
# Only NEXT_PUBLIC_* values are exposed to the browser; everything else is
# server-side. Keys appear exactly once — duplicate keys silently override each
# other and were the cause of earlier provider configuration drift.
# See docs/UNIFIED_PROJECT_ENVIRONMENT_VARIABLES.md for the full contract.
# ============================================================

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3051
HOSTNAME=127.0.0.1
NEXT_PUBLIC_APP_URL=https://hosting.alolabs.net
APP_URL=https://hosting.alolabs.net
BASE_URL=https://hosting.alolabs.net
BUILD_ID=""
ALLOW_PREVIEW_EMBED=0

# ── Database (SQLite via libSQL; use an ABSOLUTE file: URL in production) ───
DATABASE_URL="file:/var/lib/alo-hosting/production.db"
E2E_DB=""
REDIS_URL=""

# ── Authentication & secrets (REQUIRED in production; startup fails closed) ─
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
JWT_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
NEXTAUTH_URL="https://hosting.alolabs.net"
APP_ENCRYPTION_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32"
INTERNAL_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
CSRF_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
CRON_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32"
# Optional: service manager used by /api/automation/tool (systemd | pm2)
AUTOMATION_SERVICE_MANAGER="systemd"
AUTOMATION_SERVICE_NAME="alo-hosting-panel"
SECRET_KEY=""
ADMIN_EMAIL="admin@alolabs.net"
ADMIN_CREDENTIAL_FILE=""
ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_RESELLER_PASSWORD=""
SEED_CLIENT_PASSWORD=""
PANEL_EMAIL="admin@alolabs.net"
PANEL_PASSWORD=""

# ── Browser isolation / CORS ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="https://hosting.alolabs.net"
CROSS_ORIGIN_OPENER_POLICY="same-origin"
CROSS_ORIGIN_RESOURCE_POLICY="same-site"

# ── Privileged host helpers & site storage ─────────────────────────────────
ALO_HELPER_DIR="/usr/local/sbin"
ALO_SITES_DIR="/var/www"
ALO_NGINX_DIR="/etc/nginx/sites-available"
ALO_NGINX_ENABLED_DIR="/etc/nginx/sites-enabled"
ALO_CERTBOT_EMAIL="admin@alolabs.net"
ALO_BACKUP_DIR="/var/backups/alo"
# Optional: absolute path for the best-effort file audit trail. Defaults to
# $ALO_BACKUP_DIR/alo-automation-audit.log, or the OS temp directory.
AUDIT_FALLBACK_FILE=""
ALO_PROJECT_DIR="/opt/alo-hosting-portal"
ALO_ENV_PATH="/etc/alo-hosting/panel.env"
ALO_AGENT_STATE="/var/lib/alo-hosting/agent"
ALO_PANEL_URL="http://127.0.0.1:3051"
ALO_HEARTBEAT_MS=30000
ALO_POLL_MS=5000
ALO_WATCH_SERVICES=""
ALO_ENROLL_TOKEN=""
ALO_CLOUD_API_KEY=""
PROVISION_SITE_HELPER="/usr/local/sbin/provision-site.sh"
PROVISION_LOCAL_SERVER_ID="replace-with-local-server-record-uuid"
SSL_STATUS_HOOK_TOKEN="REPLACE_WITH_OPENSSL_RAND_HEX_32"
SSL_STATUS_API_URL="http://127.0.0.1:3051/api/internal/sites/ssl-status"
MAX_UPLOAD_SIZE_MB=500
STORAGE_BUCKET_BASE=""
STORAGE_ROOT=""
CLOUD_DATA_DIR=""
TEMP_DIR=""

# ── GitHub integration & Git-connected auto-deploy ─────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_REPOSITORY=""
GITHUB_API_URL="https://api.github.com"
GITHUB_OAUTH_URL="https://github.com/login/oauth"
GITHUB_CLONE_BASE_URL="https://github.com"
REPO_FULL_NAME=""
EXPECT_SHA=""
DEPLOY_WEBHOOK_SECRET=""
DEPLOY_RELEASE_BASE="/var/lib/alo-hosting/releases"
DEPLOY_ENV_FILE_BASE="/etc/alo-hosting"
DEPLOY_BIND_HOST="127.0.0.1"
DEPLOY_STATIC_PORT_BASE=4100
DEPLOY_DOMAIN_SUFFIX=""
DEPLOY_PUBLIC_URL_TEMPLATE=""
DEPLOY_COMMAND_TIMEOUT_MS=900000
DEPLOY_WORKER_INTERVAL_MS=5000
# Standalone deploy worker (deploy/systemd/alo-deploy-worker.service). The
# interval is clamped to 500..60000ms and the batch to 1..25 rows per tick.
DEPLOY_WORKER_BATCH=5
DEPLOY_WORKER_HEARTBEAT_FILE="/tmp/alo-deploy-worker.json"
DEPLOY_WORKER_ID=""
DEPLOY_INLINE_WORKER=false
DEPLOY_ALLOW_LOCAL_SOURCE=0
# Local release execution is allowed only when no node profile/default agent is
# selected. Set false to require an enrolled node for application deployment.
DEPLOY_LOCAL_EXECUTION=true
DEPLOY_PUBLIC_IP=""
AUTOMATION_DEFAULT_AGENT_ID=""
# Reverse-proxy / TLS listener ports on enrolled compute nodes (the ALO Edge).
# Defaults are the standard 80/443; change when nodes run the edge on high ports.
DEPLOY_EDGE_HTTP_PORT=80
DEPLOY_EDGE_HTTPS_PORT=443
# The node kit's ALO Edge (deploy/node-kit/alo-edge.mjs) reads these on each
# compute node; they mirror DEPLOY_EDGE_* so operators configure one set.
ALO_EDGE_HTTP_PORT=80
ALO_EDGE_HTTPS_PORT=443
ALO_EDGE_SITES_DIR="/etc/alo-hosting/edge/sites"
ALO_EDGE_TLS_BASE="/etc/alo-hosting/tls"
ALO_EDGE_BIND="0.0.0.0"
# Panel-side bind (Next.js server); not a node-kit variable.
ALO_BIND_HOST="127.0.0.1"
# Autonomous safe recovery: allow the self-healing workflow's two preapproved,
# bounded verbs (process restart, release rollback) to execute without a human
# approval, recording the policy identity on every agent task. Set false to
# require an explicit approval for every recovery.
AUTOMATION_AUTONOMOUS_RECOVERY=true
DEPLOY_DISABLE_BOOT_RESTORE=0
LOCAL_SOURCE=""
SOURCE_PORT=3051
ALLOW_INSECURE_WEBHOOK_HTTP=0
ALLOW_RELEASE_ROLLBACK=0
RELEASE_ROLLBACK_OPERATOR=""
RELEASE_ROLLBACK_REASON=""
LATEST_MAIN_TIMEOUT_MS=15000
TEST_HEAD=""
TEST_LOOKUP_EXIT=""

# ── SSO / OAuth / MFA ──────────────────────────────────────────────────────
SSO_ENABLED=0
SSO_PROVIDER=""
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_METADATA_URL=""
GOOGLE_CLIENT_ID=""

# ── SMTP / notifications ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@alolabs.net"

# ── DNS / SSL / network providers ─────────────────────────────────────────
DNS_PROVIDER_MODE=""
RDAP_BASE_URL="https://rdap.org/domain"
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# ── CRM / internal service integration ────────────────────────────────────
CRM_INTEGRATION_SIGNING_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32"

# ── Orchestrator / workers ─────────────────────────────────────────────────
ORCHESTRATOR_INTERVAL_MS=5000
ORCHESTRATOR_WORKER_ID=""
ORCHESTRATOR_MAX_JOBS=5
ORCHESTRATOR_HEARTBEAT_FILE=/tmp/alo-automation-worker.json
NEXT_WORKER_ID=""
NEXT_PHASE=""
NEXT_RUNTIME=""

# ── AI providers (all optional, server-side only, never NEXT_PUBLIC_*) ─────
# Ordered failover chain. Configuration alone is never reported as health:
# verify live with GET /api/ai/status?probe=1 (requires authentication).
AI_PROVIDER_ORDER=""
AI_PROVIDER=""
AI_FREE_ONLY="false"
AI_ALLOW_ANONYMOUS="true"
AI_TIMEOUT_MS=60000
AI_RETRIES_PER_PROVIDER=1
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""
PROVIDER_OPENAI_API_KEY=""
AI_MODEL_OPENAI=""

LLM7_API_KEY=""
LLM7_BASE_URL="https://api.llm7.io/v1"
AI_MODEL_LLM7=""

GROQ_API_KEY=""
AI_MODEL_GROQ=""

UNOROUTER_API_KEY=""
UNOROUTER_BASE_URL="https://api.unorouter.com/v1"
AI_MODEL_UNOROUTER=""
OKROUTER_API_KEY=""
OKROUTER_BASE_URL="https://api.okrouter.com/v1"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL_OPENROUTER=""

QWEN_API_KEY=""
QWEN_BASE_URL=""
AI_MODEL_QWEN=""

GLM_API_KEY=""
ZHIPU_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
AI_MODEL_GLM="glm-5"
GLM_REASONING_EFFORT=""

AI_GATEWAY_URL="http://127.0.0.1:4000/v1"
AI_GATEWAY_KEY=""
AI_MODEL_GATEWAY=""

OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
AI_MODEL_OLLAMA=""

LOCALAI_BASE_URL=""
LOCALAI_API_KEY=""
AI_MODEL_LOCALAI=""

# ── Payments (optional Stripe) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET_2=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Rate limiting / logging ────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
# Number of reverse-proxy hops in front of the application (SEC-05). 0 means
# "no proxy": forwarding headers are ignored and the transport peer address is
# used, so a client cannot choose its own rate-limit bucket. Set this to the real
# hop count (e.g. 1 for a single Caddy/nginx, 2 for Cloudflare + nginx) or every
# request will be treated as unidentifiable and limited per request.
TRUSTED_PROXY_COUNT=0
LOG_LEVEL="info"


# ── Customer build isolation (SEC-01) ──────────────────────────────────────
# A customer repository's install/build/test scripts are untrusted code. They are
# executed inside a namespace boundary (bubblewrap, else unshare on Linux, else
# sandbox-exec on macOS) instead of inheriting the control plane's identity.
#
# auto      try bwrap -> unshare -> sandbox-exec, fall back to none (dev default)
# required  a boundary is mandatory; the deployment FAILS if none is available
#           (this is the default when NODE_ENV=production)
# bwrap | unshare | sandbox-exec   pin one implementation (fails if unavailable)
# none      no boundary; refused in production unless the override below is set
DEPLOY_BUILD_ISOLATION="auto"
# Set to 1 only as a documented, temporary exception to run unisolated builds in
# production. Never leave it set: it restores the SEC-01 exposure.
DEPLOY_ALLOW_UNISOLATED_BUILDS=0
# Allow the build namespace an outbound network. Off by default: a build that
# needs the network should use a pre-populated package cache, not arbitrary egress.
DEPLOY_BUILD_NETWORK=0
# Apply prlimit ceilings (address space, process count, file size, open files,
# CPU seconds) to the build process when the boundary is active.
DEPLOY_BUILD_RLIMITS=0
DEPLOY_BUILD_MAX_ADDRESS_SPACE_BYTES=4294967296
DEPLOY_BUILD_MAX_PROCESSES=512
DEPLOY_BUILD_MAX_FILE_SIZE_BYTES=2147483648
DEPLOY_BUILD_MAX_OPEN_FILES=4096
DEPLOY_BUILD_MAX_CPU_SECONDS=3600
# Work directory root allowed for isolated builds when it is not the OS tmpdir.
DEPLOY_BUILD_WORKROOT=""
# Allow the platform (server) GitHub token to reach private repositories. Off by
# default: a token shared by every tenant must not expose ALO's private repos.
DEPLOY_ALLOW_PLATFORM_TOKEN_PRIVATE_REPOS=0

# ── Node agent (SEC-07) ────────────────────────────────────────────────────
# Non-loopback panel URLs must be https, because the enrollment response carries
# the agent signing secret. Set to 1 only for a private, already-encrypted hop.
ALO_ALLOW_INSECURE_PANEL=0

# ── Test-only switches (never set in production) ───────────────────────────
# ALO_ISOLATION_PROBE=1 enables the real-containment probe in
# tests/build-isolation.test.ts; it needs a host where unprivileged user
# namespaces work. ALO_TEST_CANARY_SECRET is planted by a test to prove a build
# environment cannot see control-plane variables.
ALO_ISOLATION_PROBE=0
ALO_TEST_CANARY_SECRET=""

# NOTE: HOME, PATH, npm_lifecycle_event and npm_package_version are provided by
# the runtime/package manager and are intentionally not configurable here.
