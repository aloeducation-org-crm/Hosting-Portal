# ═══════════════════════════════════════════════════════════════
# ALO Labs Hosting Portal — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit real secrets to version control.

# Application
# PORT is the single source of truth for the panel port. Everything else
# (systemd unit, docker-compose, Caddy upstream, healthcheck) reads it from here.
# 3101 is the default; set 3051 if that is what the domain is published on.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3101
APP_URL=https://hosting.alolabs.net
# Whatever terminates TLS must proxy to this same port:
#   nginx:      proxy_pass http://127.0.0.1:3051;   (deploy/nginx/hosting.alolabs.net.conf)
#   Caddy:      reverse_proxy 127.0.0.1:{$PORT:3101}
# Production uses 3051 on alo-server-lap; 3101 is the default in src/lib/env.ts.

# Auth — Generate with: openssl rand -hex 32
NEXTAUTH_URL=https://hosting.alolabs.net
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
JWT_SECRET=generate-with-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encryption — 32-byte hex key (openssl rand -hex 32)
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Cloudflare DNS & SSL
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LiteLLM AI Gateway
AI_GATEWAY_URL=http://localhost:4000/v1
AI_GATEWAY_KEY=

# Database — SQLite via the libSQL driver adapter.
# prisma/schema.prisma is provider = "sqlite" and migrations are locked to
# sqlite, so a postgresql:// URL will NOT work: the generated client cannot open
# it. Moving to PostgreSQL means changing the provider and regenerating every
# migration — see README.md "Database".
#
# The path MUST be absolute (a relative file: URL resolves against the process
# working directory, so systemd/PM2/CI each open a different file) and MUST live
# outside the repository (db/custom.db is tracked by git, so any checkout
# replaces production data with the committed snapshot).
# Create it with:  sudo bash scripts/init-production-db.sh
DATABASE_URL="file:/var/lib/alo-hosting/alo.db"

# Filesystem paths
SITE_BASE=/srv/alo-sites
BACKUP_BASE=/var/backups/alo-sites
CADDY_CONFIG_DIR=/etc/caddy/sites-enabled
CADDY_LOG_DIR=/var/log/caddy/alo-sites

# Timeouts & Limits
HELPER_TIMEOUT_SECONDS=120
DEPLOY_TIMEOUT_SECONDS=1800
BACKUP_RETENTION_COUNT=14
MAX_UPLOAD_SIZE9MB=500

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Feature flags
ALLOW_STATIC=true
ALLOW_PHP=true
ALLOW_NODE=true
ALLOW_NEXTJS=true
COMMERCIAL_HOSTING=false

# AI model gateway (optional; server-side only; OpenAI-compatible chat/completions API)
# UnoRouter is a gateway/storefront, not a free model or free inference guarantee.
# Set this to the gateway's API base URL (usually ending in /v1), and provide an
# authorized gateway key and a model ID enabled by that gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Redis (optional — for session store / queue)
REDIS_URL=

# SMTP (optional — for email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alolabs.net

# Internal secret — Generate with: openssl rand -hex 32
INTERNAL_SECRET=generate-with-openssl-rand-hex-32
