# ═══════════════════════════════════════════════════════════════
# ALO Labs Hosting Portal — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit real secrets to version control.

# Application
# PORT is the single source of truth for the panel port. Everything else
# (systemd unit, docker-compose, Caddy upstream, healthcheck) reads it from here.
# 3101 is the default; set 3051 if that is what the domain is published on.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3101
APP_URL=https://hosting.alolabs.net
# Whatever terminates TLS must proxy to this same port:
#   nginx:      proxy_pass http://127.0.0.1:3051;   (deploy/nginx/hosting.alolabs.net.conf)
#   Caddy:      reverse_proxy 127.0.0.1:{$PORT:3101}
# Production uses 3051 on alo-server-lap; 3101 is the default in src/lib/env.ts.

# Auth — Generate with: openssl rand -hex 32
NEXTAUTH_URL=https://hosting.alolabs.net
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
JWT_SECRET=generate-with-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encryption — 32-byte hex key (openssl rand -hex 32)
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Cloudflare DNS & SSL
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LiteLLM AI Gateway
AI_GATEWAY_URL=http://localhost:4000/v1
AI_GATEWAY_KEY=

# Database — SQLite via the libSQL driver adapter.
# prisma/schema.prisma is provider = "sqlite" and migrations are locked to
# sqlite, so a postgresql:// URL will NOT work: the generated client cannot open
# it. Moving to PostgreSQL means changing the provider and regenerating every
# migration — see README.md "Database".
#
# The path MUST be absolute (a relative file: URL resolves against the process
# working directory, so systemd/PM2/CI each open a different file) and MUST live
# outside the repository (db/custom.db is tracked by git, so any checkout
# replaces production data with the committed snapshot).
# Create it with:  sudo bash scripts/init-production-db.sh
DATABASE_URL="file:/var/lib/alo-hosting/alo.db"

# Filesystem paths
SITE_BASE=/srv/alo-sites
BACKUP_BASE=/var/backups/alo-sites
CADDY_CONFIG_DIR=/etc/caddy/sites-enabled
CADDY_LOG_DIR=/var/log/caddy/alo-sites

# Timeouts & Limits
HELPER_TIMEOUT_SECONDS=120
DEPLOY_TIMEOUT_SECONDS=1800
BACKUP_RETENTION_COUNT=14
MAX_UPLOAD_SIZE9MB=500

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Feature flags
ALLOW_STATIC=true
ALLOW_PHP=true
ALLOW_NODE=true
ALLOW_NEXTJS=true
COMMERCIAL_HOSTING=false

# ═══════════════════════════════════════════════════════════════
# AI providers (server-side only; OpenAI-compatible chat/completions)
# ═══════════════════════════════════════════════════════════════
# The panel tries providers in order and fails over on rate limits/outages.
# See AI-PROVIDER-INTEGRATION.md for the full matrix and docs/AI-AUTOMATION.md
# for the workflow engine. Verify live with: GET /api/ai/status?probe=1

# Free tier (no key required). Optional free token raises rate limits.
AI_ALLOW_ANONYMOUS=true
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
AI_MODEL_LLM7=gpt-oss:20b

# Paid gateway. The repo under github.com/unorouter/unorouter is the storefront,
# not free inference: you need an account, credits and a token. Confirm the API
# host in your own dashboard; the default below is unverified.
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
AI_MODEL_UNOROUTER=gpt-4o-mini

# Other paid/optional providers
GROQ_API_KEY=
PROVIDER_OPENAI_API_KEY=
# Roadmap model adapters (OpenAI-compatible). Add to AI_PROVIDER_ORDER to use.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_OPENROUTER=openai/gpt-4o-mini
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL_QWEN=qwen-plus

# Self-hosted gateway (LiteLLM/vLLM) or Ollama. Opt-in: only used when the URL is set.
AI_GATEWAY_URL=http://127.0.0.1:4000/v1
AI_GATEWAY_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Chain behaviour
AI_PROVIDER_ORDER=unorouter,llm7,groq,openrouter,qwen
AI_FREE_ONLY=false
AI_PROVIDER=
AI_TIMEOUT_MS=60000
AI_RETRIES_PER_PROVIDER=1
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# Legacy explicit gateway: when OPENAI_API_KEY is set this pair is tried FIRST,
# before the chain above (kept so existing deployments keep working).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Redis (optional — for session store / queue)
REDIS_URL=

# SMTP (optional — for email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alolabs.net

# Internal secret — Generate with: openssl rand -hex 32
INTERNAL_SECRET=generate-with-openssl-rand-hex-32

# ═══════════════════════════════════════════════════════════════════════════
# Git-connected automatic deployment (GitHub App / OAuth)
# See docs/GIT-AUTODEPLOY.md. Never commit real values.
# ═══════════════════════════════════════════════════════════════════════════
# Preferred: a GitHub App with Contents: read, Metadata: read,
# Webhooks: read/write, and the app-level webhook event subscriptions
# (push, pull_request, ping). The private key may be PEM or base64 PEM.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Alternative: OAuth "Connect GitHub" (repo + admin:repo_hook scopes) — or a
# server-side PAT for staging. OAuth/PAT tokens stored in the DB are AES-256-GCM
# encrypted with APP_ENCRYPTION_KEY.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Optional overrides for staging/tests only.
GITHUB_API_URL=https://api.github.com
GITHUB_CLONE_BASE_URL=
GITHUB_OAUTH_URL=https://github.com/login/oauth

# Deployment host. Release dirs must be outside the repository. The static
# service manager binds to DEPLOY_BIND_HOST; set 0.0.0.0 only behind a proxy.
DEPLOY_RELEASE_BASE=/var/lib/alo-hosting/releases
DEPLOY_BIND_HOST=127.0.0.1
DEPLOY_STATIC_PORT_BASE=4100
DEPLOY_PUBLIC_URL_TEMPLATE=
DEPLOY_COMMAND_TIMEOUT_MS=600000
DEPLOY_INLINE_WORKER=true
DEPLOY_WORKER_INTERVAL_MS=2000
DEPLOY_DOMAIN_SUFFIX=apps.alolabs.net
DEPLOY_ENV_FILE_BASE=/etc/alo-hosting/build-env
# Staging only: permits cloneUrlOverride on POST /api/deploy/projects.
DEPLOY_ALLOW_LOCAL_SOURCE=false
