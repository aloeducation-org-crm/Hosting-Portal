# ============================================================================
# ALO Hosting Portal — environment configuration
# ----------------------------------------------------------------------------
# This file is named `.env.config` (NOT `.env`). Next.js corrupts `$` in .env
# files, so the platform loads its configuration from `.env.config`, which
# `ecosystem.config.cjs` reads with fs.readFileSync() and merges into the
# process environment before the standalone server starts.
#
# Copy to `.env.config` and replace every placeholder with a real value:
#   cp .env.config.example .env.config
#
# Generate strong secrets with:
#   openssl rand -hex 32        # for secrets / keys
#   openssl rand -hex 16        # for 16-byte values
# ============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=production
PORT=3054
NEXTAUTH_URL=https://panel.alolabs.net

# ---- Database (SQLite via Prisma + libSQL adapter) ---------------------------
DATABASE_URL="file:./dev.db"

# ---- Auth (NextAuth v4, JWT strategy) ----------------------------------------
# 64-char random string. The production loader refuses to start on defaults.
NEXTAUTH_SECRET="replace-with-openssl-rand-hex-32"
# JWT_SECRET is read as a secondary JWT secret by the app's env loader.
JWT_SECRET="replace-with-openssl-rand-hex-32"

# ---- Redis (rate limiting + caching) ----------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ---- Cron / internal secrets ------------------------------------------------
CRON_SECRET="replace-with-openssl-rand-hex-32"
INTERNAL_SECRET="replace-with-openssl-rand-hex-32"

# ---- Encryption (AES-256-GCM key material, 64 hex chars) -------------------
ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"
APP_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"

# ---- AI (Ollama, local, CPU-only, 120s timeout) -----------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"

# ---- SMTP (Nodemailer) ------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="email@gmail.com"
SMTP_PASS="app-password"
SMTP_FROM="ALO Hosting <noreply@alolabs.net>"

# ---- Billing (Stripe — placeholder OK for Phase 1) -------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---- Cloudflare (DNS + SSL + registrar) -------------------------------------
CLOUDFLARE_API_TOKEN="xxx"
CLOUDFLARE_ZONE_ID="xxx"
CLOUDFLARE_ACCOUNT_ID="xxx"

# ---- GitHub (OAuth + webhooks) ---------------------------------------------
GITHUB_CLIENT_ID="xxx"
GITHUB_CLIENT_SECRET="xxx"

# ---- OAuth (optional, registered only when real secrets are set) -----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Hosting / DNS provider modes ------------------------------------------
# local | cloudflare | powerdns | registrar
DNS_PROVIDER_MODE="local"

# ---- Filesystem paths -------------------------------------------------------
SITE_BASE="/srv/alo-sites"
BACKUP_BASE="/var/backups/alo-sites"

# ---- Rate limiting (per IP / per user) --------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
