[Unit]
Description=ALO Labs Hosting Portal
After=network.target postgresql.service mariadb.service caddy.service php8.2-fpm.service
Wants=postgresql.service

[Service]
Type=simple
User=alo-panel
Group=alo-panel
WorkingDirectory=/opt/alo-hosting-portal
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

# Defaults only — /opt/alo-hosting-portal/.env is loaded afterwards and wins.
Environment=NODE_ENV=production
Environment=PORT=3101
Environment=HOSTNAME=127.0.0.1
# Single source of truth for PORT, HOSTNAME and secrets.
EnvironmentFile=-/opt/alo-hosting-portal/.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/alo-hosting-portal /tmp
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alo-hosting-portal

[Install]
WantedBy=multi-user.target
