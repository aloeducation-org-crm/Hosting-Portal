# Hardened Next.js standalone unit. Requires the dedicated `alo-panel` service
# account, membership/group permissions for the release and database, and a
# root-owned /etc/alo-hosting/panel.env (mode 0640, group alo-panel).
[Unit]
Description=ALO Labs Hosting Panel (Next.js standalone)
Documentation=https://github.com/aloeducation-org-crm/Hosting-Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alo-panel
Group=alo-panel
WorkingDirectory=/opt/alo-hosting/current/.next/standalone
EnvironmentFile=/etc/alo-hosting/panel.env
Environment=NODE_ENV=production
Environment=PORT=3051
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/alo-hosting/current/.next/standalone/server.js

Restart=always
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30
LimitNOFILE=65535
MemoryMax=2G
MemorySwapMax=0
OOMPolicy=kill

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alo-hosting-panel

# The process invokes only root-owned allowlisted helpers through sudoers.
# sudo requires SUID and cannot work under NoNewPrivileges/RestrictSUIDSGID.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
ReadWritePaths=/var/lib/alo-hosting
ReadWritePaths=-/srv/alo-sites
ReadWritePaths=-/var/backups/alo-sites
ReadWritePaths=-/opt/alo-hosting/logs
ReadWritePaths=-/opt/alo-hosting/current/.next/cache
ReadWritePaths=-%h/.ssh
ReadWritePaths=-/etc/caddy
ReadWritePaths=-/etc/nginx
ReadWritePaths=-/etc/systemd/system
ReadWritePaths=-/etc/letsencrypt
ReadWritePaths=-/var/lib/letsencrypt
ReadWritePaths=-/var/log/letsencrypt
ReadWritePaths=-/etc/ufw
ReadWritePaths=-/etc/cron.d
ReadWritePaths=-/var/spool/cron
ReadWritePaths=-/etc/postfix
ReadWritePaths=-/etc/dovecot
ReadWritePaths=-/etc/rspamd
ReadWritePaths=-/var/vmail
ReadWritePaths=-/etc/alo-dns
ReadWritePaths=-/etc/bind
ReadWritePaths=-/var/cache/bind
ReadWritePaths=-/var/log/caddy
ReadWritePaths=-/var/log/nginx

[Install]
WantedBy=multi-user.target
