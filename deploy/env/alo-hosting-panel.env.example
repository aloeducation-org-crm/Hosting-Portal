# Copy to /etc/alo-hosting/panel.env; never commit the real file.
# Protect with root:alo-panel ownership and mode 0640. Use unique generated secrets.
NODE_ENV=production
PORT=3051
HOSTNAME=127.0.0.1
DATABASE_URL=file:/var/lib/alo-hosting/alo.db
NEXTAUTH_URL=https://hosting.alolabs.net
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-a-different-openssl-rand-hex-32
APP_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
INTERNAL_SECRET=replace-with-openssl-rand-hex-32

# Exact comma-separated browser origins; empty means same-origin only.
# Do not use '*' with credentialed requests.
CORS_ALLOWED_ORIGINS=https://hosting.alolabs.net
CROSS_ORIGIN_OPENER_POLICY=same-origin
CROSS_ORIGIN_RESOURCE_POLICY=same-site

# Internal SSL helper callback: generate >=32 random bytes and install the same
# secret in /etc/alo-hosting/ssl-hook.token (root:root 0600).
SSL_STATUS_HOOK_TOKEN=replace-with-openssl-rand-hex-32
SSL_STATUS_API_URL=http://127.0.0.1:3051/api/internal/sites/ssl-status
PROVISION_SITE_HELPER=/usr/local/sbin/provision-site.sh
# UUID of the Server record that physically runs this panel (prevents accidental
# local Nginx edits when a remote server is selected).
PROVISION_LOCAL_SERVER_ID=replace-with-local-server-record-uuid
