  @@index([ruleId])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}

// ─── Usage & Billing ───────────────────────────────────────────────────────────

model UsageRecord {
  id          String   @id @default(uuid())
  userId      String
  websiteId   String?
  resource    String   // bandwidth_mb, storage_gb, requests, cpu_hours, memory_gb_hours
  quantity    Float
  unitPrice   Float    @default(0)
  totalCost   Float    @default(0)
  billed      Boolean  @default(false)
  invoiceId   String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([websiteId])
  @@index([resource])
  @@index([periodStart, periodEnd])
  @@index([billed])
  @@map("usage_records")
}

// ─── Application Records ───────────────────────────────────────────────────────

model Application {
  id          String   @id @default(uuid())
  name        String
  websiteId   String?
  type        String   // web, api, worker, cron, database
  status      String   @default("active") // active, paused, stopped, error
  runtime     String?
  version     String?
  config      Json?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([userId])
  @@index([status])
  @@map("applications")
}

// ─── PromptTemplate ─────────────────────────────────────────────────────────

model PromptTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String?
  content     String?
  variables   String?  // JSON-encoded variable definitions
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("prompt_templates")
}

// ─── AIConversation & AIMessage ─────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  websiteId String?
  title     String   @default("New Conversation")
  mode      String   @default("assistant") // builder, assistant, log_analyzer, seo, support
  model     String   @default("gemini-2.0-flash")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@index([websiteId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // system, user, assistant
  content        String
  tokensUsed     Int      @default(0)
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ─── TokenUsage ─────────────────────────────────────────────────────────────

model TokenUsage {
  id          String   @id @default(uuid())
  userId      String
  model       String?
  promptTokens Int     @default(0)
  completionTokens Int @default(0)
  totalTokens Int     @default(0)
  costUsd     Float    @default(0)
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("token_usage")
}

// ─── AiWorkflow ─────────────────────────────────────────────────────────────

model AiWorkflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  nodes       String?  // JSON-encoded workflow nodes
  edges       String?  // JSON-encoded workflow edges
  status      String   @default("draft") // draft, active, archived
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs        AiWorkflowRun[]

  @@index([userId])
  @@index([status])
  @@map("ai_workflows")
}

/// One execution of an AiWorkflow by the automation engine.
/// `steps` and `input`/`output` hold JSON text so a run is replayable without a
/// second join table; see src/lib/ai/automation/runner.ts.
model AiWorkflowRun {
  id          String   @id @default(uuid())
  workflowId  String
  userId      String?
  trigger     String   @default("manual") // manual, schedule, webhook
  status      String   @default("running") // running, succeeded, failed
  dryRun      Boolean  @default(false)
  input       String?
  output      String?
  steps       String?
  error       String?
  providers   String?  // comma-separated provider ids that answered
  aiCalls     Int      @default(0)
  tokensUsed  Int      @default(0)
  durationMs  Int?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  workflow    AiWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@map("ai_workflow_runs")
}

// ─── Contact (form submissions) ─────────────────────────────────────────────

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  // Software Factory funnel fields (nullable, added additively):
  source    String? // e.g. website-form, industry-landing, service-page
  industry  String? // IndustrySystem slug
  service   String? // ServiceDefinition slug
  status    String? // new | qualified | converted | closed
  createdAt DateTime @default(now())

  @@index([email])
  @@map("contacts")
}

