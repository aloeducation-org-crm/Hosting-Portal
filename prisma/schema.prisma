  algorithm   String   @default("round_robin")
  targets     String?  // JSON-encoded target list
  sslCertId   String?
  status      String   @default("active")
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("load_balancers")
}

// ─── Newsletter ─────────────────────────────────────────────────────────────

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletters")
}

