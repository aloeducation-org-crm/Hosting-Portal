// ─────────────────────────────────────────────────────────────────────────────
// Git-connected automatic deployment (2026-10-26)
//
// All three tables are ADDITIVE. They deliberately hold plain String foreign
// keys instead of Prisma relations so that no existing model has to be changed
// and no existing migration has to be rewritten. `Website` remains the project
// anchor: a GitProject points at one website and reuses its Deployment,
// Release, DeploymentLog, Domain and AuditLog records.
// ─────────────────────────────────────────────────────────────────────────────

model GitConnection {
  id             String   @id @default(uuid())
  provider       String   @default("github")
  mode           String   @default("app") // app | oauth | token
  accountLogin   String
  accountType    String?  // User | Organization
  installationId String?  // GitHub App installation id (app mode)
  tokenEncrypted String?  // AES-256-GCM ciphertext; NEVER a plaintext token
  scopes         String?
  connectedById  String?
  status         String   @default("active") // active | revoked
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, accountLogin])
  @@index([installationId])
  @@map("git_connections")
}

model GitProject {
  id                String   @id @default(uuid())
  websiteId         String   @unique
  connectionId      String?
  repository        String   // validated "owner/repo"
  cloneUrl          String   // server-derived clone URL, never taken from a webhook
  productionBranch  String   @default("main")
  previewBranches   String   @default("[]") // JSON array of branch names
  autoDeploy        Boolean  @default(true)
  requiresApproval  Boolean  @default(false) // ambiguous detection -> confirm first
  detection         String?  // JSON DetectionResult
  config            String?  // JSON allowlisted DeployConfig
  detectionStatus   String   @default("pending") // pending | detected | ambiguous | confirmed | failed
  healthPath        String   @default("/")
  healthUrl         String?  // optional override for an externally managed service
  serviceManager    String   @default("static") // static | pm2 | systemd | none
  serviceName       String?
  releaseRoot       String?  // absolute path on the deploy host
  port              Int?
  webhookSecretEnc  String?  // AES-256-GCM ciphertext
  webhookId         String?  // GitHub hook id, for disconnect
  lastCommitSha     String?
  lastCommitMessage String?
  lastCommitAuthor  String?
  lastDeployStatus  String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([repository, productionBranch])
  @@index([websiteId])
  @@index([connectionId])
  @@map("git_projects")
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  deliveryId     String   @unique // X-GitHub-Delivery (dedup / replay protection)
  event          String
  action         String?
  repository     String?
  installationId String?
  signatureValid Boolean  @default(false)
  result         String   // queued | duplicate | ignored | rejected | failed
  reason         String?
  projectId      String?
  deploymentId   String?
  payloadSha     String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([repository])
  @@map("webhook_deliveries")
}

// ─── App Center ───────────────────────────────────────────────────────────────
// One AppDefinition per app (created once, reused by every company/tenant).
// One CompanyApp row per (app, organization): the per-company installation
// with its own branding + settings overrides (Odoo-style app catalog).

model AppDefinition {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  summary         String?
  description     String?
  category        String   @default("productivity") // finance | sales | people | projects | support | ai | content | website | operations | marketing | productivity | communication
  icon            String? // lucide-react icon name
  accentColor     String? // hex, e.g. #E8501A
  version         String   @default("1.0.0")
  status          String   @default("active") // active | hidden
  isSystem        Boolean  @default(false) // built-in catalog entries are never deleted
  route           String? // optional deep link into the hosting portal
  configSchema    Json? // settings field descriptors: [{key,label,type,default?,options?}]
  defaultSettings Json? // catalog-wide default settings values
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  installations CompanyApp[]

  @@index([category])
  @@index([status])
  @@map("app_definitions")
}

model CompanyApp {
  id             String   @id @default(uuid())
  appId          String
  organizationId String
  enabled        Boolean  @default(true)
  branding       Json? // per-company overrides: {name?, logoUrl?, accentColor?}
  settings       Json? // per-company overrides of configSchema fields
  installedBy    String?
  installedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  app          AppDefinition @relation(fields: [appId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([appId, organizationId])
  @@index([organizationId])
  @@index([appId])
  @@map("company_apps")
}

// ─── Software Factory: Industry System Registry ─────────────────────────────
// One record per industry-specific software product family (20 total).
// `modules`, `features`, `challenges`, `workflow`, `faqs` and `reports` are
// structured JSON consumed by the admin registry and the public landing pages.

model IndustrySystem {
  id         String  @id @default(uuid())
  slug       String  @unique
  name       String
  tagline    String // hero value proposition
  summary    String // directory card text
  icon       String  @default("Building2") // lucide icon name
  accentFrom String  @default("#4f46e5") // per-industry hero gradient
  accentTo   String  @default("#9333ea")
  order      Int     @default(0)
  status     String  @default("published") // draft | published | hidden
  modules    Json // [{key, name, description, mandatory}]
  features   Json // [{group, items: [string]}]
  challenges Json // [{title, description}]
  workflow   Json // [string]
  faqs       Json // [{q, a}]
  reports    Json // [string]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  services ServiceIndustry[]

  @@index([status])
  @@map("industry_systems")
}

// ─── Software Factory: Service Catalog ──────────────────────────────────────
// A service is a sellable deliverable (may use apps/modules/human work).
// No price columns: pricing is quotation-based (priceMode) by policy.

model ServiceDefinition {
  id           String  @id @default(uuid())
  slug         String  @unique
  name         String
  category     String // software | marketing | seo | email | whatsapp | social | analytics
  summary      String
  description  String
  deliverables Json // [{name, description?}]
  prerequisites Json // [string]
  exclusions   Json // [string] — honest scope boundaries
  requiredApps Json // [app slug] references AppDefinition.slug
  priceMode    String @default("quotation") // quotation — no prices are stored
  version      String @default("1.0.0")
  status       String @default("published") // draft | published | retired
  order        Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  industries ServiceIndustry[]

  @@index([status])
  @@index([category])
  @@map("service_catalog")
}

// Industry↔service applicability: core | recommended | optional (§9 mapping).
model ServiceIndustry {
  id         String           @id @default(uuid())
  serviceId  String
  industryId String
  relation   String           @default("recommended") // core | recommended | optional
  service    ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  industry   IndustrySystem   @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([serviceId, industryId])
  @@index([industryId])
  @@map("service_industries")
}
