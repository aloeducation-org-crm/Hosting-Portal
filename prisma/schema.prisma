  deals     CrmDeal[]

  @@index([userId])
  @@index([status])
  @@index([email])
  @@index([company])
  @@map("crm_contacts")
}

model CrmDeal {
  id             String   @id @default(uuid())
  title          String
  value          Float    @default(0)
  stage          String   @default("qualification") // qualification, proposal, negotiation, closed_won, closed_lost
  probability    Int      @default(0)
  expectedClose  DateTime?
  contactId      String?
  pipelineId     String?
  userId         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contact   CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline CrmPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  activities CrmActivity[]

  @@index([userId])
  @@index([stage])
  @@index([pipelineId])
  @@index([contactId])
  @@map("crm_deals")
}

model CrmPipeline {
  id        String   @id @default(uuid())
  name      String
  stages    String   // JSON array of stage names
  isDefault Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals CrmDeal[]
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("crm_pipelines")
}

model CrmActivity {
  id          String   @id @default(uuid())
  type        String   // email, call, meeting, note, task
  subject     String
  description String?
  contactId   String?
  dealId      String?
  userId      String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contactId])
  @@index([dealId])
  @@index([type])
  @@index([scheduledAt])
  @@map("crm_activities")
}

// ─── CI/CD ─────────────────────────────────────────────────────────────────────

model CiPipeline {
  id          String   @id @default(uuid())
  name        String
  websiteId   String?
  repository  String?
  branch      String   @default("main")
  buildCmd    String?
  deployCmd   String?
  status      String   @default("active") // active, paused, archived
  lastBuildAt DateTime?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website?  @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  builds  CiBuild[]
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([status])
  @@index([userId])
  @@map("ci_pipelines")
}

model CiBuild {
  id             String   @id @default(uuid())
  pipelineId     String
  number         Int
  commitHash     String?
  commitMessage  String?
  branch         String?
  status         String   @default("pending") // pending, running, success, failed, cancelled
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  buildOutput    String?
  deployOutput   String?
  error          String?
  triggeredBy    String?
  createdAt      DateTime @default(now())

