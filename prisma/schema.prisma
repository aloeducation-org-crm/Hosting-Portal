  branch      String   @default("main")
  buildCmd    String?
  deployCmd   String?
  status      String   @default("active") // active, paused, archived
  lastBuildAt DateTime?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website?  @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  builds  CiBuild[]
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([status])
  @@index([userId])
  @@map("ci_pipelines")
}

model CiBuild {
  id             String   @id @default(uuid())
  pipelineId     String
  number         Int
  commitHash     String?
  commitMessage  String?
  branch         String?
  status         String   @default("pending") // pending, running, success, failed, cancelled
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  buildOutput    String?
  deployOutput   String?
  error          String?
  triggeredBy    String?
  createdAt      DateTime @default(now())

  pipeline CiPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, number])
  @@index([pipelineId])
  @@index([status])
  @@index([createdAt])
  @@map("ci_builds")
}

// ─── Firewall ──────────────────────────────────────────────────────────────────

model FirewallRule {
  id        String   @id @default(uuid())
  name      String
  action    String   @default("allow") // allow, deny, reject
  direction String   @default("ingress") // ingress, egress
  protocol  String   @default("tcp") // tcp, udp, icmp, all
  port      Int?
  portRange String?  // e.g. "8000-9000"
  source    String?  // CIDR or IP
  dest      String?  // CIDR or IP
  isActive  Boolean  @default(true)
  priority  Int      @default(1000)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([priority])
  @@index([direction])
  @@map("firewall_rules")
}

// ─── Storage ───────────────────────────────────────────────────────────────────

model StorageBucket {
  id          String   @id @default(uuid())
  name        String   @unique
  provider    String   @default("local") // local, s3, gcs
  region      String?
  accessKey   String?
  secretKey   String?  // encrypted
  endpoint    String?
  bucketPath  String?
  sizeBytes   BigInt   @default(0)
  objectCount Int      @default(0)
  isActive    Boolean  @default(true)
  // §12 logical storage pools share this table: pool rows use kind "pool"
  // (name = STUDENT_STORAGE | PARTNER_STORAGE | ...), buckets stay "bucket".
  kind        String   @default("bucket") // bucket | pool
  quotaBytes  BigInt?  // pool quota; null = unlimited
  policy      String?  // JSON access policy / metadata for pool rows
  userId      String?  // creator (pools: null = platform-managed)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
  @@index([kind])
  @@map("storage_buckets")
}

/// §13 document management — one row per stored file version. Files live under
/// a pool's backend path (never a public static directory); every access is
/// policy-checked and audited. Grouping key for "latest version" listings is
/// (poolKey, ownerId, category, filename).
model DocumentFile {
  id             String    @id @default(uuid())
  poolKey        String    // STUDENT_STORAGE | PARTNER_STORAGE | ...
  ownerId        String?    // uploading user (tenant ownership)
  organizationId String?    // owning organization when tenant-scoped
  category       String    // validated against the pool's category list
  filename       String    // sanitized display name (no path components)
  storagePath    String    // path relative to the pool backend (never public)
  sizeBytes      BigInt
  sha256         String    // integrity hash computed on upload
  version        Int       @default(1)
  contentType    String
  createdAt      DateTime  @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([poolKey, ownerId])
  @@index([organizationId])
  @@index([category])
  @@map("document_files")
}

// ─── Orders ────────────────────────────────────────────────────────────────────

model Order {
  id             String   @id @default(uuid())
  orderNumber    String   @unique
  userId         String
  status         String   @default("pending") // pending, processing, completed, cancelled, refunded
  totalCents     Int
  currency       String   @default("USD")
  paymentMethod  String?
  paymentRef     String?
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  description String
  type        String   // domain, plan_upgrade, addon, service
  quantity    Int      @default(1)
  unitPriceCents Int
  totalCents  Int
  metadata    Json?    // extra details about the item
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// ─── Email Campaigns ───────────────────────────────────────────────────────────

model EmailCampaign {
