  @@index([status])
  @@map("support_tickets")
}

// ─── Task ───────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  projectId   String?
  priority    String    @default("medium") // low, medium, high, urgent
  status      String    @default("pending") // pending, in_progress, completed, cancelled
  dueDate     DateTime?
