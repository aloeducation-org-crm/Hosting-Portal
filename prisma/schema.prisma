// ─── DNS Records ───────────────────────────────────────────────────────────────

model DnsRecord {
  id        String   @id @default(uuid())
  domainId  String
  type      String   // A, AAAA, CNAME, MX, TXT, NS, SRV, CAA
  name      String   // subdomain (e.g. "www" or "@" for root)
  value     String   // IP, hostname, text value
  ttl       Int      @default(3600)
  priority  Int?     // for MX, SRV
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([type])
  @@index([name])
  @@map("dns_records")
}

// ─── MFA ───────────────────────────────────────────────────────────────────────

model UserMfa {
  id            String   @id @default(uuid())
  userId        String   @unique
  method        String   @default("totp") // totp, sms, email
  secret        String?  // encrypted TOTP secret
  backupCodes   String?  // JSON array of hashed backup codes
  isVerified    Boolean  @default(false)
  isEnabled     Boolean  @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

// ─── Monitoring & Alerts ──────────────────────────────────────────────────────

model AlertRule {
  id          String   @id @default(uuid())
  name        String
  metric      String   // cpu, memory, disk, bandwidth, ssl_expiry, downtime
  condition   String   // gt, lt, gte, lte, eq
  threshold   Float
  serverId    String?
  websiteId   String?
  cooldownMin Int      @default(5)
  isActive    Boolean  @default(true)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  alerts   Alert[]

  @@index([isActive])
  @@index([metric])
  @@map("alert_rules")
}

model Alert {
  id          String   @id @default(uuid())
  ruleId      String
  severity    String   @default("warning") // info, warning, critical
  message     String
  value       Float?
  threshold   Float?
  isRead      Boolean  @default(false)
  acknowledgedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}

