// ─── CRM ──────────────────────────────────────────────────────────────────────

model CrmContact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  position    String?
  status      String   @default("lead") // lead, prospect, customer, churned
