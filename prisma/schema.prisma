generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RESELLER
  CLIENT
  DEVOPS
  SUPPORT
  VIEWER
}

enum WebsiteRuntime {
  STATIC
  PHP82
  NODE
  NEXTJS
}

enum WebsiteStatus {
  ACTIVE
  SUSPENDED
  DEPLOYING
  RESTARTING
  DELETED
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLING_BACK
  ROLLED_BACK
}

enum DatabaseEngine {
  MARIADB
  POSTGRESQL
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  SUSPENDED
  DEPLOYING
  RESTORING
  UNKNOWN
}

enum OperationJobStatus {
  PENDING
  QUEUED
  VALIDATING
  WAITING_APPROVAL
  RUNNING
  VERIFYING
  RETRYING
  SUCCESS
  FAILED
  CANCELLED
  ROLLING_BACK
  ROLLED_BACK
  DEAD_LETTER
}

/// Which specialized worker may execute a job, and how much trust it needs.
enum WorkerKind {
  REPO_DISCOVERY
  FRAMEWORK_DETECTION
  BUILD_TEST
  SECURITY_ANALYSIS
  RELEASE
  INFRASTRUCTURE
  DATABASE_OPS
  DOMAIN_TLS
  MONITORING_RECOVERY
  BACKUP_RESTORE
}

enum RiskLevel {
  READ_ONLY
  REVERSIBLE
  PRIVILEGED
  DESTRUCTIVE
}

enum AgentTaskStatus {
  PENDING
  ASSIGNED
  RUNNING
  SUCCEEDED
  FAILED
  REFUSED
  TIMED_OUT
  CANCELLED
}

enum ReplicationRole {
  PRIMARY
  REPLICA
  STANDBY
  UNKNOWN
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackupType {
  MANUAL
  SCHEDULED
  PRE_DEPLOY
}

enum RestoreJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum SslStatus {
  NONE
  PENDING
  ISSUED
  FAILED
  EXPIRED
  RENEWING
}

// Server states retained by the existing portal plus the hosting lifecycle
// states used by automated provisioning.
enum ServerStatus {
  ACTIVE
  ERROR
  PROVISIONING
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum SiteSslStatus {
  ACTIVE
  EXPIRED
  PENDING
}

// ─── Role & Permission ────────────────────────────────────────────────────────

model Role {
  id          String          @id @default(uuid())
  name        UserRole        @unique
  description String?
  createdAt   DateTime        @default(now())

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  name                String?
  image               String?
  companyName         String?
  useCase             String?
  passwordHash        String?
  roleId              String
  isActive            Boolean      @default(true)
  onboardingCompleted Boolean      @default(false)
  onboardingStep      Int          @default(0)
  failedLoginAttempts Int          @default(0)
  isLocked            Boolean      @default(false)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  emailVerified       DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  role               Role                @relation(fields: [roleId], references: [id])
  accounts           Account[]
  verificationTokens VerificationToken[]
  memberships        Membership[]
  aiConversations    AIConversation[]
  sessions           Session[]
  auditLogs          AuditLog[]
  websites           Website[]           @relation("WebsiteOwner")
  notifications      Notification[]
  apiKeys            ApiKey[]
  backups            Backup[]            @relation("BackupCreator")
  restoreJobs        RestoreJob[]
  fileOperations     FileOperation[]
  deployments        Deployment[]        @relation("DeploymentActor")
  operationJobs      OperationJob[]
  subscriptions      Subscription[]
  aiAgentRuns        AiAgentRun[]
  sshKeys            SshKey[]
  invoices           Invoice[]
  crmContacts        CrmContact[]
  crmDeals           CrmDeal[]
  crmPipelines       CrmPipeline[]
  crmActivities      CrmActivity[]
  ciPipelines        CiPipeline[]
  firewallRules      FirewallRule[]
  storageBuckets     StorageBucket[]
  documentFiles      DocumentFile[]
  orders             Order[]
  emailCampaigns     EmailCampaign[]
  alertRules         AlertRule[]
  usageRecords       UsageRecord[]
  applications       Application[]
  mfa                UserMfa?

  @@index([email])
  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

// ─── OAuth Account & Email Verification ──────────────────────────────────────

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  id         String    @id @default(uuid())
  identifier String
  token      String    @unique
  type       String    @default("EMAIL_VERIFICATION")
  expiresAt  DateTime
  usedAt     DateTime?
  userId     String?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
  @@index([identifier])
  @@index([token])
  @@map("verification_tokens")
}

// ─── Organization, Team & Membership ─────────────────────────────────────────

model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  planId       String?
  ownerId      String
  isWhiteLabel Boolean  @default(false)
  customDomain String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teams       Team[]
  memberships Membership[]
  websites    Website[]
  companyApps CompanyApp[]

  @@index([ownerId])
  @@index([slug])
  @@map("organizations")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model Membership {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  teamId         String?
  role           String    @default("MEMBER")
  invitedBy      String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([teamId])
  @@map("memberships")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(uuid())
  actorUserId     String?
  actorEmail      String?
  actorRole       String?
  action          String
  resourceType    String?
  resourceId      String?
  domain          String?
  result          String?
  requestId       String?
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime @default(now())
  metadata        Json?
  errorCode       String?
  durationMs      Int?
  operationJobId  String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  operationJob OperationJob? @relation(fields: [operationJobId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@index([requestId])
  @@map("audit_logs")
}

// ─── Website ──────────────────────────────────────────────────────────────────

model Website {
  id                 String          @id @default(uuid())
  name               String?
  domain             String
  runtime            WebsiteRuntime
  documentRoot       String?
  status             WebsiteStatus   @default(ACTIVE)
  applicationPort    Int?
  startupCommand     String?
  buildCommand       String?
  outputDirectory    String?
  gitRepo            String?
  gitBranch          String          @default("main")
  healthPath         String?
  healthStatus       String?
  currentReleasePath String?
  ownerId            String?
  organizationId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  owner              User?              @relation("WebsiteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  environments       WebsiteEnvironment[]
  domains            Domain[]
  databaseInstances  DatabaseInstance[]
  deployments        Deployment[]
  releases           Release[]
  backups            Backup[]
  fileOperations     FileOperation[]
  serviceInstances   ServiceInstance[]
  healthCheck        HealthCheck?
  operationJobs      OperationJob[]
  restoreJobs        RestoreJob[]
  systemdServices    SystemdService[]
  serverPorts        ServerPort[]
  dockerContainers  DockerContainer[]
  cronJobs          CronJob[]
  resourceMetrics   ResourceMetric[]
  usageRecords     UsageRecord[]
  ciPipelines      CiPipeline[]
  applications     Application[]

  @@unique([domain])
  @@index([ownerId])
  @@index([organizationId])
  @@index([status])
  @@index([runtime])
  @@map("websites")
}

// ─── WebsiteEnvironment ──────────────────────────────────────────────────────

model WebsiteEnvironment {
  id        String   @id @default(uuid())
  websiteId String
  key       String
  value     String
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, key])
  @@index([websiteId])
  @@map("website_environments")
}

// ─── Domain ───────────────────────────────────────────────────────────────────

model Domain {
  id               String    @id @default(uuid())
  domain           String
  websiteId        String
  primary          Boolean   @default(false)
  sslEnabled       Boolean   @default(false)
  sslStatus        SslStatus @default(NONE)
  certificateExpiry DateTime?
  nameservers      String   // JSON-encoded nameserver array
  dnsVerified      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  website     Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  certificate SslCertificate?
  dnsRecords  DnsRecord[]

  @@unique([domain])
  @@index([websiteId])
  @@index([sslStatus])
  @@map("domains")
}

// ─── SslCertificate ───────────────────────────────────────────────────────────

model SslCertificate {
  id        String    @id @default(uuid())
  domainId  String    @unique
  issuer    String?
  notBefore DateTime?
  notAfter  DateTime?
  autoRenew Boolean   @default(true)
  createdAt DateTime  @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([notAfter])
  @@map("ssl_certificates")
}

// ─── DatabaseInstance ─────────────────────────────────────────────────────────

model DatabaseInstance {
  id        String         @id @default(uuid())
  websiteId String
  engine    DatabaseEngine
  name      String
  host      String
  port      Int
  username  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  website    Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  credentials DatabaseCredential[]

  @@unique([websiteId, name])
  @@index([websiteId])
  @@index([engine])
  @@map("database_instances")
}

// ─── DatabaseCredential ───────────────────────────────────────────────────────

model DatabaseCredential {
  id           String   @id @default(uuid())
  databaseId   String
  username     String
  passwordHash String
  privileges   String   // JSON-encoded privilege array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  database DatabaseInstance @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([databaseId])
  @@map("database_credentials")
}

// ─── Deployment ───────────────────────────────────────────────────────────────

model Deployment {
  id                String          @id @default(uuid())
  websiteId         String
  releaseId         String?   @unique
  source            String?
  commitHash        String?
  status            DeploymentStatus @default(PENDING)
  startedAt         DateTime?
  finishedAt        DateTime?
  buildOutput       String?
  healthResult      Json?
  previousReleaseId String?   @unique
  actorId           String?
  createdAt         DateTime        @default(now())

  // ── Git-connected auto-deploy (additive; nullable for all legacy rows) ──────
  projectId         String?
  deliveryId        String?
  branch            String?
  commitMessage     String?
  commitAuthor      String?
  trigger           String?   // webhook | manual | rollback
  stage             String?   // queued|checkout|detect|install|test|build|package|activate|verify|done
  failureStage      String?
  verifiedCommitSha String?
  configSnapshot    String?   // JSON, validated at rest; never raw webhook input
  durationMs        Int?

  website     Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  release     Release?        @relation("CurrentRelease", fields: [releaseId], references: [id])
  logs        DeploymentLog[]
  actor       User?           @relation("DeploymentActor", fields: [actorId], references: [id], onDelete: SetNull)
  prevRelease Release?        @relation("PreviousRelease", fields: [previousReleaseId], references: [id])

  @@index([websiteId])
  @@index([status])
  @@index([createdAt])
  @@map("deployments")
}

// ─── DeploymentLog ────────────────────────────────────────────────────────────

model DeploymentLog {
  id           String   @id @default(uuid())
  deploymentId String
  level        String
  message      String
  timestamp    DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([timestamp])
  @@map("deployment_logs")
}

// ─── Release ──────────────────────────────────────────────────────────────────

model Release {
  id         String   @id @default(uuid())
  websiteId  String
  version    Int
  path       String
  commitHash String?
  createdAt  DateTime @default(now())

  website    Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  current   Deployment? @relation("CurrentRelease")
  previous  Deployment? @relation("PreviousRelease")

  @@unique([websiteId, version])
  @@index([websiteId])
  @@map("releases")
}

// ─── Backup ───────────────────────────────────────────────────────────────────

model Backup {
  id         String       @id @default(uuid())
  websiteId  String
  filename   String
  filepath   String
  fileSize   BigInt?
  checksum   String?
  status     BackupStatus @default(PENDING)
  backupType BackupType   @default(MANUAL)
  metadata   Json?
  creatorId  String?
  createdAt  DateTime     @default(now())

  website      Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  creator      User?          @relation("BackupCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  manifest     BackupManifest?
  restoreJobs RestoreJob[]

  @@index([websiteId])
  @@index([status])
  @@index([createdAt])
  @@map("backups")
}

// ─── BackupManifest ───────────────────────────────────────────────────────────

model BackupManifest {
  id              String   @id @default(uuid())
  backupId        String   @unique
  files           Json?
  databaseDump    String?
  caddyConfig     String?
  systemdUnit     String?
  environmentVars Json?
  runtime         String?
  applicationPort Int?
  domain          String?
  createdAt       DateTime @default(now())

  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@map("backup_manifests")
}

// ─── RestoreJob ───────────────────────────────────────────────────────────────

model RestoreJob {
  id         String           @id @default(uuid())
  backupId   String
  websiteId  String
  status     RestoreJobStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  result     Json?
  error      String?
  actorId    String?
  createdAt  DateTime         @default(now())

  backup  Backup  @relation(fields: [backupId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([backupId])
  @@index([websiteId])
  @@index([status])
  @@map("restore_jobs")
}

// ─── FileOperation ────────────────────────────────────────────────────────────

model FileOperation {
  id         String   @id @default(uuid())
  websiteId  String
  action     String
  path       String
  targetPath String?
  fileSize   BigInt?
  actorId    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([action])
  @@index([createdAt])
  @@map("file_operations")
}

// ─── ServiceInstance ──────────────────────────────────────────────────────────

model ServiceInstance {
  id          String   @id @default(uuid())
  websiteId   String
  name        String
  type        String?
  systemdUnit String?
  status      String?
  createdAt   DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, name])
  @@index([websiteId])
  @@map("service_instances")
}

// ─── HealthCheck ──────────────────────────────────────────────────────────────

model HealthCheck {
  id                   String       @id @default(uuid())
  websiteId            String       @unique
  systemdState         String?
  localPort            Boolean?
  localHttp            Boolean?
  publicHttp           Boolean?
  ssl                  Boolean?
  dns                  Boolean?
  diskUsage            Int?
  processMemory        Int?
  databaseConnectivity Boolean?
  lastBackupAt         DateTime?
  overallStatus        HealthStatus @default(UNKNOWN)
  checkedAt            DateTime     @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([overallStatus])
  @@index([checkedAt])
  @@map("health_checks")
}

// ─── OperationJob ─────────────────────────────────────────────────────────────

model OperationJob {
  id           String             @id @default(uuid())
  /// Null for platform-wide jobs (backup drills, monitoring sweeps, audits).
  websiteId    String?
  type         String
  status       OperationJobStatus @default(PENDING)
  priority     Int                @default(100)
  progress     Int                @default(0)
  input        String?            // JSON-encoded operation input
  output       String?            // JSON-encoded operation output
  resourceId   String?
  resourceType String?
  requestId    String?
  exitCode     Int?
  stdout       String?
  stderr       String?
  error        String?
  actorId      String?
  actorEmail   String?
  actorRole    String?
  startedAt    DateTime?
  finishedAt   DateTime?
  completedAt  DateTime?
  durationMs   Int?
  createdAt    DateTime           @default(now())

  // ── Durable orchestrator (additive; nullable / safely defaulted) ────────────
  // Exactly-once enqueue: two webhooks or two clicks with the same key collapse
  // into one job instead of two deployments.
  idempotencyKey String?   @unique
  // Correlation id propagated to workers, agent tasks, logs and audit records.
  correlationId  String?
  workerKind     WorkerKind?
  riskLevel      RiskLevel @default(READ_ONLY)
  // Retry / backoff state. `attempts` counts real executions, not enqueues.
  attempts        Int      @default(0)
  maxAttempts     Int      @default(1)
  retryPolicy     String?  // JSON { baseMs, factor, maxDelayMs, jitter }
  lastError       String?
  availableAt     DateTime @default(now()) // not claimable before this instant
  leaseExpiresAt  DateTime?                // worker liveness; expiry => requeue
  leasedBy        String?                  // worker identity holding the lease
  lockKey         String?                  // concurrency domain (usually project)
  // Approval gate for PRIVILEGED / DESTRUCTIVE work.
  requiresApproval Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  approvalNote     String?
  // Dead-letter handling for jobs that exhausted their retries.
  deadLetteredAt   DateTime?
  deadLetterReason String?
  cancelledAt      DateTime?
  cancelledBy      String?
  updatedAt        DateTime  @updatedAt

  website    Website?   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  auditLogs  AuditLog[]

  @@index([websiteId])
  @@index([status])
  @@index([type])
  @@index([requestId])
  @@index([createdAt])
  @@index([status, availableAt])
  @@index([lockKey])
  @@index([correlationId])
  @@index([leaseExpiresAt])
  @@map("operation_jobs")
}

// ─── Secure server agent ─────────────────────────────────────────────────────
// One row per managed Linux host (Hostinger Cloud, Office A, Office B…).
// The agent authenticates with a rotated key, never with a shared password, and
// only ever receives allowlisted tasks.

model ServerAgent {
  id             String    @id @default(uuid())
  serverId       String?
  name           String
  // Stable public identity, safe to show in the dashboard.
  agentKey       String    @unique
  // HMAC key used to sign heartbeats and task payloads. Stored encrypted.
  secretEnc      String
  status         String    @default("pending") // pending | active | revoked
  version        String?
  capabilities   String    @default("[]") // JSON array of allowlisted commands
  scopes         String    @default("[]") // JSON array of permission scopes
  lastHeartbeat  DateTime?
  lastSeenIp     String?
  enrolledAt     DateTime?
  revokedAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  server  Server?      @relation(fields: [serverId], references: [id], onDelete: SetNull)
  tasks   AgentTask[]
  metrics AgentMetric[]
  nonces  AgentNonce[]

  @@index([status])
  @@index([serverId])
  @@index([lastHeartbeat])
  @@map("server_agents")
}

/// Short-lived, single-use enrollment token exchanged for an agent secret.
/// One row per consumed agent request nonce. The unique index on
/// (agentId, nonce) is the replay guard: a captured signed request can be
/// presented once, and a second presentation — even concurrently — fails the
/// insert. Rows expire with the signature window they belong to.
model AgentNonce {
  id        String   @id @default(uuid())
  agentId   String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  agent ServerAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, nonce])
  @@index([expiresAt])
  @@map("agent_nonces")
}

model AgentEnrollmentToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique // sha256 of the token; plaintext shown once
  prefix     String
  agentName  String
  serverId   String?
  scopes     String    @default("[]")
  capabilities String  @default("[]")
  expiresAt  DateTime
  usedAt     DateTime?
  usedByIp   String?
  createdById String?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@map("agent_enrollment_tokens")
}

model AgentTask {
  id            String          @id @default(uuid())
  agentId       String
  jobId         String?         // orchestrator job that produced this task
  correlationId String?
  command       String          // must be in the agent's allowlist
  args          String          @default("{}") // JSON, validated against a schema
  status        AgentTaskStatus @default(PENDING)
  // Copy of the allowlist entry's limits, frozen at dispatch time.
  timeoutMs     Int             @default(30000)
  requiresApproval Boolean      @default(false)
  approvedBy    String?
  /// When the human approval was recorded. An approval is only valid for a
  /// bounded window: a task that sits unclaimed past it must be re-approved,
  /// because the operator's decision was about the host state at that moment.
  approvedAt    DateTime?
  dispatchedAt  DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  exitCode      Int?
  result        String?         // JSON structured result
  logs          String?         // sanitized (redacted) stdout/stderr
  error         String?
  refuseReason  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  agent ServerAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([status, createdAt])
  @@index([jobId])
  @@map("agent_tasks")
}

/// Real metrics reported by the agent. Absence of rows means "unavailable",
/// never a fabricated zero.
model AgentMetric {
  id            String   @id @default(uuid())
  agentId       String
  cpuPercent    Float?
  memoryUsedMb  Float?
  memoryTotalMb Float?
  diskUsedGb    Float?
  diskTotalGb   Float?
  loadAvg1m     Float?
  uptimeSeconds Float?
  netInKbps     Float?
  netOutKbps    Float?
  services      String?  // JSON [{ name, state }]
  recordedAt    DateTime @default(now())

  agent ServerAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, recordedAt])
  @@map("agent_metrics")
}

/// MySQL/MariaDB (or PostgreSQL) replication state as *observed*, not assumed.
model ReplicationStatus {
  id             String           @id @default(uuid())
  serverId       String?
  host           String
  engine         String           // mysql | mariadb | postgresql | sqlite
  version        String?
  role           ReplicationRole  @default(UNKNOWN)
  binlogEnabled  Boolean?
  gtidMode       String?
  binlogPosition String?
  replicaOf      String?
  lagSeconds     Int?
  lastCheckedAt  DateTime?
  healthy        Boolean?
  detail         String?          // JSON, credentials removed
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@unique([host])
  @@index([engine])
  @@map("replication_status")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
