// ─── Subscription & Billing ───────────────────────────────────────────────────

model Plan {
  id                    String         @id @default(uuid())
  name                  String         @unique
  slug                  String?        @unique
  description           String?
  priceCents            Int            @default(0)
  interval              String         @default("monthly") // monthly, yearly
