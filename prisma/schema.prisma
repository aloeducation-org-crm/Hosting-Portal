  @@map("user_mfa")
}

// ─── Monitoring & Alerts ──────────────────────────────────────────────────────

model AlertRule {
  id          String   @id @default(uuid())
  name        String
  metric      String   // cpu, memory, disk, bandwidth, ssl_expiry, downtime
  condition   String   // gt, lt, gte, lte, eq
  threshold   Float
  serverId    String?
  websiteId   String?
  cooldownMin Int      @default(5)
